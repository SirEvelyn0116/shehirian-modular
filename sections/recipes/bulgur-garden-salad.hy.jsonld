{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "ձավարի ցորեն Garden Salad",
  "author": "Շահիրյան ընտանիք",
  "description": "A versatile garden salad with ձավարի ցորեն wheat, fresh vegetables, and hard-bձեթed ձուs — perfect as a side or main dish.",
  "recipeCategory": "Աղցան",
  "recipeCuisine": "Ամերիկյան",
  "recipeYield": "8 պորցիա",
  "prepTime": "PT15M",
  "cookTime": "PT15M",
  "totalTime": "PT30M",
  "recipeIngredient": [
    "2 բաժակ եփած ձավար ցորեն",
    "1 բաժակ խառնելed մանրացված vegetables (լոլիկ, վարունգ, bell պղպեղ)",
    "2 hard-եփելed ձու, կտրատված",
    "1/4 բաժակ ձիթապտղի ձեթ",
    "2 ճաշի գդալ կիտրոն juice",
    "Աղ and պղպեղ to taste",
    "Թարմ մաղադանոս for garnish"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Եփել ձավար and allow to cool."
    },
    {
      "@type": "HowToStep",
      "text": "Խառնել մանրացված vegetables and կտրատված ձու in a bowl."
    },
    {
      "@type": "HowToStep",
      "text": "Ավելացնել ձավար and toss gently."
    },
    {
      "@type": "HowToStep",
      "text": "Whisk ձիթապտղի ձեթ, կիտրոն juice, աղ and պղպեղ; pour over աղցան and toss to coat."
    },
    {
      "@type": "HowToStep",
      "text": "Chill briefly before պորցիա."
    }
  ]
}