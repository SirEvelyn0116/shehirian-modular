{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Shirag Tabulee Salad",
  "author": "Shehirian family",
  "description": "A parsley-rich Tabulee with Shirag Fine Bulgor, tomato, cucumber and green pepper, dressed with olive oil and lemon.",
  "recipeCategory": "Salad",
  "recipeCuisine": "",
  "recipeYield": "3 servings",
  "prepTime": "",
  "cookTime": "",
  "totalTime": "",
  "recipeIngredient": [
    "1 cup Shirag Fine Bulgor",
    "3/4 cup water",
    "1 cup finely chopped parsley",
    "1 cup diced tomatoes",
    "1/2 cup peeled and diced cucumber",
    "1/4 cup diced green bell pepper",
    "1/2 cup olive oil",
    "1/4 cup lemon juice",
    "1 tbsp finely chopped mint",
    "1 tsp salt"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "In a bowl, combine the water and Shirag Fine Bulgor. Let stand until the water is absorbed, about 20 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "In a salad bowl, mix all the ingredients until the dressing is well distributed."
    },
    {
      "@type": "HowToStep",
      "text": "Allow 15 minutes before serving."
    }
  ]
}