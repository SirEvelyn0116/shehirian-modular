{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Bulgur Carrot Raisin Salad",
  "author": "Shehirian family",
  "description": "A variation with raisins and French dressing for a delightful sweet and tangy flavor.",
  "recipeCategory": "Salad",
  "recipeCuisine": "American",
  "recipeYield": "8-10 servings",
  "prepTime": "PT10M",
  "cookTime": "PT15M",
  "totalTime": "PT25M",
  "recipeIngredient": [
    "2 cups cooked bulgur wheat",
    "1 1/2 cups shredded carrots",
    "1/2 cup raisins",
    "1/2 cup French dressing (or vinaigrette)",
    "Salt and pepper to taste"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Combine cooked bulgur, shredded carrots, and raisins in a bowl."
    },
    {
      "@type": "HowToStep",
      "text": "Add French dressing and toss to coat."
    },
    {
      "@type": "HowToStep",
      "text": "Chill before serving."
    }
  ]
}