{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "India Lamb Pilaf",
  "description": "A spiced lamb pilaf with curry and apples, using bulgur.",
  "author": { "@type": "Person", "name": "Laurence Evelyn" },
  "recipeCuisine": "Indian-Inspired",
  "recipeCategory": "Main Dish",
  "recipeYield": "5-6 servings",
  "prepTime": "PT15M",
  "cookTime": "PT40M",
  "totalTime": "PT55M",
  "recipeIngredient": [
    "Oil, cooked lamb cubes, chopped onion, tart apple, garlic, celery seed, curry powder, ginger, salt, pepper, Tabasco, tomato purée, consommé or water, bulgur"
  ],
  "recipeInstructions": [
    "Sauté lamb with onion, apple and garlic; brown lightly.",
    "Blend in remaining ingredients, bring to boil then simmer about 40 minutes until thickened."
  ],
  "keywords": "lamb pilaf,curry,bulgur"
}
