{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Bulgor Meat Loaf",
  "author": "Shehirian family",
  "description": "A meatloaf enriched with Bulgor wheat and baked until browned.",
  "recipeCategory": "Main Dish",
  "recipeCuisine": "International",
  "recipeYield": "10 to 12 servings",
  "prepTime": "",
  "cookTime": "PT1H",
  "totalTime": "PT1H",
  "recipeIngredient": [
    "2-1/2 cups cooked Bulgor wheat",
    "1 egg",
    "1-1/4 cups milk",
    "2 teaspoons salt",
    "1/4 teaspoon pepper",
    "1/4 to 1/2 cup chopped onion",
    "1/4 cup ketchup",
    "2 pounds ground beef"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Blend all ingredients together."
    },
    {
      "@type": "HowToStep",
      "text": "Turn into loaf pan or shape into loaf in shallow baking dish. Bake in moderate oven, 325°F., about 1 hour or until browned."
    },
    {
      "@type": "HowToStep",
      "text": "Optionally spread a thin layer of ketchup on top before baking."
    }
  ]
}