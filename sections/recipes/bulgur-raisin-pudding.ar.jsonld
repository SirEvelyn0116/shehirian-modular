{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "بودينغ البرغل والزبيب التقليدي",
  "author": "لورنس إيفلين",
  "description": "بودينغ برغل مخبوز مع الزبيب.",
  "recipeCategory": "حلوى",
  "recipeCuisine": "عالمي",
  "recipeYield": "5-6 حصص",
  "prepTime": "PT10M",
  "cookTime": "PT1H30M",
  "totalTime": "PT1H40M",
  "recipeIngredient": [
    "1 1/2 كوب ماء",
    "2 1/2 كوب برغل مطبوخ",
    "1 1/2 كوب حليب مبخر",
    "1/3 كوب سكر",
    "1/2 ملعقة صغيرة ملح",
    "1/4 ملعقة صغيرة مايس",
    "1/2 كوب زبيب بدون بذور"
  ],
  "recipeInstructions": [
    { "@type": "HowToStep", "text": "اخلط جميع المكونات في طبق خبز." },
    { "@type": "HowToStep", "text": "غطِّ واخبز في فرن متوسط الحرارة 160°C لمدة 45 دقيقة." },
    { "@type": "HowToStep", "text": "أزل الغطاء، حرك، واستمر في الخبز بدون غطاء حوالي 45 دقيقة أو حتى يتحمر." }
  ]
}
