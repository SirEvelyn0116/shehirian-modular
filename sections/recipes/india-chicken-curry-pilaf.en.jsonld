{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "India Chicken Curry Pilaf",
  "author": "Shehirian family",
  "description": "A creamy curried chicken pilaf with Bulgor and apples.",
  "recipeCategory": "Main Dish",
  "recipeCuisine": "Indian-Inspired",
  "recipeYield": "5-6 servings",
  "prepTime": "PT15M",
  "cookTime": "PT25M",
  "totalTime": "PT40M",
  "recipeIngredient": [
    "Butter or chicken fat, chopped onion, tart apple, celery, curry powder, ginger, flour, salt, pepper, chicken stock, cream or milk, cooked diced chicken, bulgur"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Sauté onion, apple and celery in butter; add spices and flour then stir in stock and cream until thickened."
    },
    {
      "@type": "HowToStep",
      "text": "Add cooked chicken and bulgur, cover and simmer over low heat 25 minutes."
    }
  ]
}