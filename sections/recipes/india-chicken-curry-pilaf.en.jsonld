{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "India Chicken Curry Pilaf",
  "author": "Shehirian family",
  "description": "A creamy curried chicken pilaf with Bulgor and apples.",
  "recipeCategory": "Main Dish",
  "recipeCuisine": "Indian-Inspired",
  "recipeYield": "5 to 6 servings",
  "prepTime": "",
  "cookTime": "PT25M",
  "totalTime": "PT25M",
  "recipeIngredient": [
    "1/4 cup butter or chicken fat",
    "1/2 cup chopped onion",
    "1 medium-sized tart apple, peeled, cored and chopped",
    "1 cup thinly sliced celery",
    "1-1/2 to 2 teaspoons curry powder",
    "1/8 teaspoon ginger",
    "2 tablespoons flour",
    "1-1/2 teaspoons salt",
    "1/4 teaspoon pepper",
    "4-1/2 cups chicken stock",
    "1/2 cup cream or milk",
    "2 to 3 cups cooked diced chicken",
    "1 cup Bulgor"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Sauté the onion, apple, and celery in the butter until the onions are straw-coloured."
    },
    {
      "@type": "HowToStep",
      "text": "Blend in the curry powder, ginger, flour, salt, and pepper."
    },
    {
      "@type": "HowToStep",
      "text": "Remove from heat and stir in the chicken stock and cream."
    },
    {
      "@type": "HowToStep",
      "text": "Return to heat and stir constantly until the mixture thickens and comes to a boil."
    },
    {
      "@type": "HowToStep",
      "text": "Add the cooked diced chicken and Bulgor; cover and simmer over low heat 25 minutes."
    }
  ]
}