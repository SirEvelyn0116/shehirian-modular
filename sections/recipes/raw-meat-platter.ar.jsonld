{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "طبق اللحم النيء",
  "author": "Shehirian family",
  "description": "خليط لحم ضأن نيء متبّل مع برغل يُقدّم على شكل قطع.",
  "recipeCategory": "مقبلات",
  "recipeCuisine": "شرق أوسطية",
  "recipeYield": "5-6 حصص",
  "prepTime": "PT20M",
  "cookTime": "PT0M",
  "totalTime": "PT20M",
  "recipeIngredient": [
    "1 كوب (حوالي 450 جم) لحم ضأن خالي من الدهن مفروم مرتين",
    "فلفل أخضر مفروم ناعماً",
    "بقدونس مفروم ناعماً",
    "بصل أخضر مفروم ناعماً",
    "1 كوب برغل ناعم",
    "1 بصلة صغيرة مفرومة ناعماً",
    "فلفل حريف (اختياري)",
    "ملح وفلفل حسب الذوق"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "استخدم لحم الضأن فقط (يفضل الفخذ) وقدّمه في نفس اليوم الذي تمّ فيه طحنه."
    },
    {
      "@type": "HowToStep",
      "text": "ملّح اللحم وامزجه."
    },
    {
      "@type": "HowToStep",
      "text": "أضف البرغل والبصل والخضروات المفرومة واعجن بقليل من الماء حتى تتماسك المكونات."
    },
    {
      "@type": "HowToStep",
      "text": "شكّل أقراصًا بقطر 2 انش وقدّم فوراً مع تزيين بالخضروات المفرومة."
    }
  ]
}