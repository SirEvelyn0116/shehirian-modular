  "recipeIngredient": [
    "1 كوب لحم ضأن خالي من الدهن مفروم مرتين",
    "فلفل أخضر مفروم ناعماً",
    "بقدونس مفروم ناعماً",
    "بصل أخضر مفروم ناعماً",
