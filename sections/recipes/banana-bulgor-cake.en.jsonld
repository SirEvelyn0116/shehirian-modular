{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Banana Bulgor Cake",
  "author": "Shehirian family",
  "description": "A banana loaf-style cake that includes cooked bulgur for texture and flavor.",
  "recipeCategory": "Dessert",
  "recipeCuisine": "Baked",
  "recipeYield": "10 to 12 servings",
  "prepTime": "PT20M",
  "cookTime": "PT1H15M",
  "totalTime": "PT1H35M",
  "recipeIngredient": [
    "1/3 cup Bulgor Wheat",
    "1-1/3 cups water (for Bulgor)",
    "2 cups sifted all-purpose flour",
    "3 teaspoons baking powder",
    "1/2 teaspoon salt",
    "1/2 cup butter",
    "1 cup sugar",
    "2 eggs",
    "1 teaspoon vanilla",
    "3/4 cup mashed banana",
    "1 teaspoon lemon juice",
    "1/4 cup milk"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Combine Bulgor and water; cover and simmer about 20 minutes until most water is absorbed."
    },
    {
      "@type": "HowToStep",
      "text": "Sift together flour, baking powder, and salt."
    },
    {
      "@type": "HowToStep",
      "text": "Cream butter and sugar until light and fluffy; add eggs and beat until thick and creamy."
    },
    {
      "@type": "HowToStep",
      "text": "Blend cooked Bulgor, vanilla, mashed banana, and lemon juice into the creamed mixture; add flour mixture alternately with milk."
    },
    {
      "@type": "HowToStep",
      "text": "Turn into greased loaf pan and bake at 350°F about 1¼ hours."
    }
  ]
}