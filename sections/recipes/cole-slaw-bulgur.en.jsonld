{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Bulgor Cole Slaw",
  "author": "Shehirian family",
  "description": "A hearty twist on classic coleslaw with the addition of nutritious Bulgor wheat.",
  "recipeCategory": "Salad",
  "recipeCuisine": "American",
  "recipeYield": "4 to 6 servings",
  "prepTime": "",
  "cookTime": "",
  "totalTime": "",
  "recipeIngredient": [
    "2 tablespoons vinegar",
    "1/2 cup mayonnaise",
    "1-1/2 tablespoons grated onion",
    "3/4 teaspoon celery seed",
    "2-1/2 teaspoons sugar",
    "3/4 teaspoon salt",
    "1/8 teaspoon white pepper",
    "2 cups finely shredded cabbage",
    "1/2 cup Bulgor wheat"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Put 1/2 cup Bulgor wheat in one cup of water, bring to boil, cover, reduce heat, and simmer until water is absorbed; chill."
    },
    {
      "@type": "HowToStep",
      "text": "Blend all ingredients."
    },
    {
      "@type": "HowToStep",
      "text": "Serve in lettuce cups and garnish with tomato wedges."
    }
  ]
}