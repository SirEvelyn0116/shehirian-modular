{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Հայկական Ոսպով Ապուր",
  "author": "Շահիրյան ընտանիք",
  "description": "Սննդարար հայկական ապուր ոսպով, մաղադանոսով, անանուխով և կարագով։",
  "recipeCategory": "Ապուր",
  "recipeCuisine": "Հայկական",
  "recipeYield": "4 պորցիա",
  "prepTime": "PT15M",
  "cookTime": "PT60M",
  "totalTime": "PT75M",
  "recipeIngredient": [
    "1/2 բաժակ ջուր",
    "1/2 բաժակ ոսպ",
    "1/2 բաժակ կտրտած սոխ",
    "1/2 բաժակ կտրտած մաղադանոս",
    "1/2 թեյի գդալ աղ",
    "1/2 թեյի գդալ պղպեղ",
    "1/2 բաժակ կարագ կամ մարգարին",
    "1/2 բաժակ կտրտած անանուխ"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Եփել ոսպը ջրում 15 րոպե։"
    },
    {
      "@type": "HowToStep",
      "text": "Ավելացնել սոխ, մաղադանոս, աղ և պղպեղ։ Եփել 45 րոպե։"
    },
    {
      "@type": "HowToStep",
      "text": "Ավելացնել անանուխ և կարագ։ Եփել 15 րոպե։"
    },
    {
      "@type": "HowToStep",
      "text": "Ավելացնել 1/4 թեյի գդալ պղպեղ և եփել 5 րոպե։"
    },
    {
      "@type": "HowToStep",
      "text": "Ըստ ցանկության՝ տապակել կարագը մինչև բաց շագանակագույն և լցնել ապուրի վրա։"
    }
  ]
}