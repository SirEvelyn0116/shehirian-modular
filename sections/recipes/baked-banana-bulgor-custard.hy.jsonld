{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Baked Banana ձավարի ցորեն Custard",
  "author": "Շահիրյան ընտանիք",
  "description": "A baked custard-style dessert made with cooked ձավարի ցորեն and mashed banana.",
  "recipeCategory": "Կրկեսային",
  "recipeCuisine": "Baked",
  "recipeYield": "6 պորցիա",
  "prepTime": "PT10M",
  "cookTime": "PT45M",
  "totalTime": "PT55M",
  "recipeIngredient": [
    "1-1/2 բաժակ եփած ձավար",
    "1/2 բաժակ mashed բանան",
    "1 ճաշի գդալ կիտրոնի հյութ",
    "1 թեյի գդալ grated կիտրոն rind",
    "1 թեյի գդալ վանիլ",
    "1/3 բաժակ շաքար",
    "1/8 թեյի գդալ աղ",
    "2 բաժակ կաթ",
    "2 ձու, slightly ծեծելen",
    "1 ճաշի գդալ melted կարագ"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Խառնել all ingկարմիրients in a թխման աման."
    },
    {
      "@type": "HowToStep",
      "text": "Ցրել lightly with դարչին."
    },
    {
      "@type": "HowToStep",
      "text": "Թխել in moderate վառարան for 40 to 45 րոպե or until set."
    }
  ]
}