{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Bulgur Garden Salad",
  "author": "Shehirian family",
  "description": "A versatile garden salad with bulgur wheat, fresh vegetables, and hard-boiled eggs — perfect as a side or main dish.",
  "recipeCategory": "Salad",
  "recipeCuisine": "American",
  "recipeYield": "8 servings",
  "prepTime": "PT15M",
  "cookTime": "PT15M",
  "totalTime": "PT30M",
  "recipeIngredient": [
    "2 cups cooked bulgur wheat",
    "1 cup mixed chopped vegetables (tomato, cucumber, bell pepper)",
    "2 hard-boiled eggs, sliced",
    "1/4 cup olive oil",
    "2 tbsp lemon juice",
    "Salt and pepper to taste",
    "Fresh parsley for garnish"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Cook bulgur and allow to cool."
    },
    {
      "@type": "HowToStep",
      "text": "Combine chopped vegetables and sliced eggs in a bowl."
    },
    {
      "@type": "HowToStep",
      "text": "Add bulgur and toss gently."
    },
    {
      "@type": "HowToStep",
      "text": "Whisk olive oil, lemon juice, salt and pepper; pour over salad and toss to coat."
    },
    {
      "@type": "HowToStep",
      "text": "Chill briefly before serving."
    }
  ]
}