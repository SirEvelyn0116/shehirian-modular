{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "بروغل مخبوز على طريقة بوسطن",
  "description": "طبق برغل مخبوز حلو-مالح يُغطّى بالبيكون أو الملح.",
  "author": { "@type": "Person", "name": "لورنس إيفلين" },
  "recipeCuisine": "أمريكي",
  "recipeCategory": "طاجن",
  "recipeYield": "4-5 حصص",
  "prepTime": "PT10M",
  "cookTime": "PT1H25M",
  "totalTime": "PT1H35M",
  "recipeIngredient": [
    "2.5 كوب برغل مطبوخ",
    "2/3 كوب حساء طماطم مركز",
    "3 ملعقة طعام دبس السكر",
    "3/4 كوب ماء أو مرق",
    "3 ملعقة طعام سكر بني",
    "1/2 ملعقة صغيرة خردل جاف",
    "1/2 ملعقة صغيرة ملح",
    "1-2 ملعقة طعام بصل مفروم",
    "1 ملعقة طعام صلصة ورشستر",
    "2 أونصة لحم مملح أو بيكون"
  ],
  "recipeInstructions": [
    "امزج جميع المكونات باستثناء اللحم الملح في طاجن.",
    "اضغط شرائح اللحم المملح أو البيكون على السطح.",
    "غطي واخبز عند 160°C لمدة 45 دقيقة، ثم اكشف واستمر في الخبز حوالي 40 دقيقة."
  ],
  "keywords": "مخبوز,برغل,بوسطن"
}
