{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "بروغل مخبوز على طريقة بوسطن",
  "author": "Shehirian family",
  "description": "طبق برغل مخبوز حلو-مالح يُغطّى بالبيكون أو اللحم المملح.",
  "recipeCategory": "طاجن",
  "recipeCuisine": "أمريكي",
  "recipeYield": "4-5 حصص",
  "prepTime": "PT10M",
  "cookTime": "PT1H25M",
  "totalTime": "PT1H35M",
  "recipeIngredient": [
    "2.5 كوب برغل مطبوخ",
    "2/3 كوب حساء طماطم مركز",
    "3 ملعقة طعام دبس السكر",
    "3/4 كوب ماء أو مرق",
    "3 ملعقة طعام سكر بني",
    "1/2 ملعقة صغيرة خردل جاف",
    "1/2 ملعقة صغيرة ملح",
    "1-2 ملعقة طعام بصل مفروم",
    "1 ملعقة طعام صلصة ورشستر",
    "2 أونصة لحم مملح أو بيكون"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "اخلط جميع المكونات باستثناء اللحم المملح في طاجن."
    },
    {
      "@type": "HowToStep",
      "text": "قطع اللحم المملح أو البيكون إلى شرائح واضغطها على سطح الخليط."
    },
    {
      "@type": "HowToStep",
      "text": "غط وخبز على 160°C لمدة 45 دقيقة؛ اكشف واستمر في الخبز حوالي 40 دقيقة."
    }
  ]
}