{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Թագավորական Ապուր",
  "author": "Շահիրյան ընտանիք",
  "description": "Մերձավոր Արևելյան կիտրոնով և միսով գնդիկներով ապուր բրնձով և մաղադանոսով։",
  "recipeCategory": "Ապուր",
  "recipeCuisine": "Մերձավոր Արևելյան",
  "recipeYield": "6 պորցիա",
  "prepTime": "PT15M",
  "cookTime": "PT30M",
  "totalTime": "PT45M",
  "recipeIngredient": [
    "1/2 gallon հավ թանձրացրած ապուր",
    "1/2 lb. ground տավարի միս (not too lean)",
    "1/4 բաժակ raw բրինձ",
    "1/4 բաժակ very finely chopped սոխ",
    "1/4 բաժակ մաղադանոս",
    "1/4 բաժակ կիտրոն juice",
    "1/4 բաժակ finely chopped ծելի",
    "1/4 tsp. աղ",
    "Slice of 2 կիտրոնs"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Mix raw meat, bulghur wheat, սոխ, մաղադանոս and seasoning together and shape into 1\" diameter balls."
    },
    {
      "@type": "HowToStep",
      "text": "Add բրինձ to the meat balls mixture."
    },
    {
      "@type": "HowToStep",
      "text": "Add meat balls to hot հավ թանձրացրած ապուր and simmer until cooked through."
    },
    {
      "@type": "HowToStep",
      "text": "Add կիտրոն juice and ծելի. Simmer for 10 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Add աղ and կիտրոն slices. Simmer for 5 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Adjust sourness, աղiness, or thickness with շաքար, ջուր, or բրինձ as needed."
    },
    {
      "@type": "HowToStep",
      "text": "Pour թանձրացրած ապուր over meatballs and serve."
    }
  ]
}