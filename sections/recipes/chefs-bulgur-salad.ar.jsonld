{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "سلطة الشيف بالبرغل",
  "author": "Shehirian family",
  "description": "سلطة رئيسية شهية تتضمن البرغل والخضروات الطازجة واختيارك من اللحوم الباردة والجبن.",
  "recipeCategory": "طبق رئيسي",
  "recipeCuisine": "أمريكية",
  "recipeYield": "8 حصص",
  "prepTime": "PT20M",
  "cookTime": "PT15M",
  "totalTime": "PT35M",
  "recipeIngredient": [
    "2 كوب برغل مطبوخ",
    "2 كوب خضروات سلطة مشكلة",
    "1 كوب طماطم مقطعة",
    "1 كوب خيار مقطع",
    "1 كوب لحوم باردة مقطعة (اختياري)",
    "1 كوب جبن مكعب (اختياري)",
    "1/4 كوب زيت زيتون",
    "2 ملعقة طعام عصير ليمون",
    "ملح وفلفل حسب الذوق"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "حضّر البرغل واتركه يبرد."
    },
    {
      "@type": "HowToStep",
      "text": "في وعاء كبير اخلط البرغل وخضروات السلطة والطماطم والخيار."
    },
    {
      "@type": "HowToStep",
      "text": "أضف اللحوم الباردة والجبن إن وُجد."
    },
    {
      "@type": "HowToStep",
      "text": "اخلط زيت الزيتون وعصير الليمون والملح والفلفل ثم امزج مع السلطة."
    },
    {
      "@type": "HowToStep",
      "text": "قدّمها باردة أو في درجة حرارة الغرفة."
    }
  ]
}