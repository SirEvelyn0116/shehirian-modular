{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "بيلاف فارسي",
  "author": "عائلة شيهريان",
  "description": "بيلاف على الطراز الفارسي باللحم والبرغل.",
  "recipeCategory": "طبق رئيسي",
  "recipeCuisine": "فارسية",
  "recipeYield": "8-10 حصص",
  "prepTime": "PT20M",
  "cookTime": "PT1H",
  "totalTime": "PT1H20M",
  "recipeIngredient": [
    "كتف ضأن مقطع مكعبات",
    "بصل مفروم",
    "طماطم مفرومة",
    "2 كوب برغل",
    "زبدة",
    "مرق أو ماء",
    "ملح وفلفل"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "اقلي مكعبات اللحم حتى تتحمر جيدًا؛ أضف البصل والطماطم واطبخ 15 دقيقة."
    },
    {
      "@type": "HowToStep",
      "text": "اسلق البرغل قليلاً في المرق المغلي، صفّه وضعه فوق اللحم؛ ضع الزبدة في الوسط واسكب المرق حول الحواف."
    },
    {
      "@type": "HowToStep",
      "text": "اخبز في فرن معتدل حوالي ساعة؛ اقلبه على صينية وقدمه ساخنًا دون خلط."
    }
  ]
}