{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "White Bread with Bulgor",
  "author": "Shehirian family",
  "description": "A soft white loaf made by incorporating cooked Bulgor into the dough.",
  "recipeCategory": "Other",
  "recipeCuisine": "Baked",
  "recipeYield": "2 (1 lb.) Loaves",
  "prepTime": "",
  "cookTime": "",
  "totalTime": "",
  "recipeIngredient": [
    "1 cup water",
    "1/4 cup Bulgor wheat",
    "1/8 teaspoon salt (for Bulgor mixture)",
    "3/4 cup milk",
    "1 package (1/4 oz.) activated dry yeast",
    "1/2 cup lukewarm water",
    "4-1/4 cups all-purpose flour (reserve 1/4 cup for dusting)",
    "2 teaspoons salt (for flour mixture)",
    "3 tablespoons sugar",
    "3 tablespoons shortening or oil"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Combine the water, Bulgor wheat, and salt. Cover and bring to a simmer; simmer about 20 minutes or until most of the water is absorbed. Do not boil. Cool to lukewarm."
    },
    {
      "@type": "HowToStep",
      "text": "Scald the milk; cool to lukewarm."
    },
    {
      "@type": "HowToStep",
      "text": "Blend the yeast in the lukewarm water; stir in the milk."
    },
    {
      "@type": "HowToStep",
      "text": "Sift together the flour, salt, and sugar."
    },
    {
      "@type": "HowToStep",
      "text": "Reserve 1/4 cup of the flour mixture. Add the remainder to the yeast mixture with the cooked Bulgor. Add the shortening. Mix thoroughly."
    },
    {
      "@type": "HowToStep",
      "text": "Knead about 10 minutes or until the dough is smooth and satiny. Form into a ball. Place in a warm greased bowl. Brush the surface lightly with oil or melted shortening. Cover and let rise in a warm place (80° to 85°F) until doubled in volume, 1-1/2 to 2 hours. The dough will retain an impression when pressed with a finger."
    },
    {
      "@type": "HowToStep",
      "text": "Punch down the dough. Turn out on a board or brown paper lightly dusted with the reserved flour. Divide into 2 equal portions. Mould each into a ball. Cover and let rest for 15 minutes. Shape into loaves. Place in lightly greased loaf pans. Brush tops lightly with oil or melted shortening. Cover and let rise in a warm place (80° to 85°F) until doubled in volume. Bake in a preheated oven, 400°F, 35 to 40 minutes."
    }
  ]
}