{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "White Bread with Bulgor",
  "description": "A soft white loaf made by incorporating cooked bulgur into the dough.",
  "recipeYield": "2 (1 lb.) Loaves",
  "prepTime": "PT30M",
  "cookTime": "PT35M",
  "totalTime": "PT1H5M",
  "recipeIngredient": [
    "1 cup water",
    "1/4 cup Bulgor wheat",
    "1/8 teaspoon salt",
    "3/4 cup milk",
    "1 package (1/4 oz.) activated dry yeast",
    "1/2 cup lukewarm water",
    "4-1/4 cups all-purpose flour",
    "2 teaspoons salt",
    "3 tablespoons sugar",
    "3 tablespoons shortening or oil"
  ],
  "recipeInstructions": [
    {"@type":"HowToStep","text":"Combine water, Bulgor, and salt; simmer until absorbed and cool to lukewarm."},
    {"@type":"HowToStep","text":"Dissolve yeast in lukewarm water and stir milk into cooled Bulgor."},
    {"@type":"HowToStep","text":"Mix flour, salt, sugar; add yeast and Bulgor mixtures and shortening, knead until smooth."},
    {"@type":"HowToStep","text":"Let rise until doubled, shape into loaves, let rise again and bake at 400°F until done."}
  ]
}
