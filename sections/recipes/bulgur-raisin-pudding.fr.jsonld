{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Pouding ancien au boulghour et raisins",
  "author": "Famille Shehirian",
  "description": "Un pouding de boulghour aux raisins.",
  "recipeCategory": "Dessert",
  "recipeCuisine": "Internationale",
  "recipeYield": "5-6 portions",
  "prepTime": "PT10M",
  "cookTime": "PT1H30M",
  "totalTime": "PT1H40M",
  "recipeIngredient": [
    "1 1/2 tasse d'eau",
    "2 1/2 tasse de boulghour cuit",
    "1 1/2 tasse de lait évaporé",
    "1/3 tasse de sucre",
    "1/2 c. à thé de sel",
    "1/4 c. à thé de macis",
    "1/2 tasse de raisins sans pépins"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Mélanger tous les ingrédients dans un plat à four."
    },
    {
      "@type": "HowToStep",
      "text": "Couvrir et cuire à four moyen 160°C pendant 45 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Retirer le couvercle, remuer et continuer la cuisson à découvert environ 45 minutes jusqu'à ce qu'il soit doré."
    }
  ]
}