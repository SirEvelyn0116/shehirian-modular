{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "هاجيس اسكتلندي مع البرغل",
  "author": "Shehirian family",
  "description": "بودنغ هاجيس تقليدي ممزوج بالبرغل.",
  "recipeCategory": "بودنغ",
  "recipeCuisine": "أسكتلندية",
  "recipeYield": "كبير (يكفي عدة أشخاص)",
  "prepTime": "PT30M",
  "cookTime": "PT3H",
  "totalTime": "PT3H30M",
  "recipeIngredient": [
    "3 قلوب ضأن",
    "1 رطل كبد",
    "1/2 رطل سوت مفروم",
    "1/2 كوب بصل مفروم",
    "1 كوب برغل",
    "3 ملعقة صغيرة ملح",
    "2 كوب مرق لحم أو مرق"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "اسلق قلوب وكبد الضأن في الماء لمدة 1.5 ساعة؛ اتركها لتبرد واطحنها."
    },
    {
      "@type": "HowToStep",
      "text": "أضف السوت والبصل والبرغل والملح والمرق؛ اخلط جيداً وبخره في قالب بودنغ مغطى لمدة 3 ساعات."
    }
  ]
}