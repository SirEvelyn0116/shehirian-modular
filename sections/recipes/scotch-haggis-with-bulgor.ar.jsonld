  "recipeIngredient": [
    "3 قلوب ضأن",
    "1 رطل كبد",
    "1/2 رطل سوت مفروم",
    "1/2 كوب بصل مفروم",
    "1 كوب برغل",
    "3 ملعقة صغيرة ملح",
    "2 كوب مرق لحم أو مرق"
  ],
  "recipeInstructions": [
    "اسلق القلوب والكبد 1.5 ساعة ثم اتركها لتبرد واطحنها.",
    "أضف السوت والبصل والبرغل والملح والمرق؛ اخلط جيداً وبخر في قالب بودنغ مغطى 3 ساعات."
