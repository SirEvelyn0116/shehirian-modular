{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "بودينغ البرغل المطهو على البخار مع الفواكه",
  "author": "عائلة شيهريان",
  "description": "بودينغ فاكهة بالبرغل مطهو على البخار على شكل رغيف",
  "recipeCategory": "حلوى",
  "recipeCuisine": "عالمي",
  "recipeYield": "حوالي 12 حصة",
  "prepTime": "PT30M",
  "cookTime": "PT2H",
  "totalTime": "PT2H30M",
  "recipeIngredient": [
    "1-1/4 كوب طحين متعدد الاستخدامات منخول",
    "2 ملعقة صغيرة بيكنج بودر",
    "1/2 ملعقة صغيرة ملح",
    "1/2 كوب زبدة أو سمن",
    "1-1/4 كوب سكر",
    "2 بيض",
    "1-1/2 كوب برغل مطبوخ",
    "1 ملعقة صغيرة فانيلا",
    "1/2 كوب برقوق مجفف (منزوع النوى) مطحون",
    "1/2 كوب زبيب مطحون",
    "1/4 كوب مشمش مجفف مطحون",
    "1 كوب حليب"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "نخل الطحين والبيكنج بودر والملح."
    },
    {
      "@type": "HowToStep",
      "text": "اخلط الزبدة والسكر حتى يصبح الخليط فاتح وهش؛ أضف البيض واخفق حتى يصبح كثيفًا."
    },
    {
      "@type": "HowToStep",
      "text": "أضف البرغل المطبوخ والفانيلا؛ أضف الفواكه المطحونة والحليب بالتناوب مع المكونات الجافة."
    },
    {
      "@type": "HowToStep",
      "text": "املأ قالب مدهون بالزيت حتى ثلاثة أرباعه، غطيه بإحكام واطبخه على البخار لمدة ساعتين. قدّمه مع كريمة مخفوقة."
    }
  ]
}