{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Hearty Bulgur Pilaf",
  "author": "Shehirian family",
  "description": "Coarse bulgur simmered with vegetables and spices for a comforting meal.",
  "recipeCategory": "طبق رئيسي",
  "recipeCuisine": "شرق أوسطية",
  "recipeYield": "4 حصص",
  "prepTime": "PT10M",
  "cookTime": "PT25M",
  "totalTime": "PT35M",
  "recipeIngredient": [
    "1 1/2 كوب برغل خشن",
    "2 ملعقة كبيرة زبدة أو زيت زيتون",
    "1 بصلة متوسطة، مقطعة",
    "2 فص ثوم، مفروم",
    "1 فلفل أحمر، مقطع",
    "1 جزرة، مقطعة",
    "3 أكواب مرق خضار",
    "1 ملعقة صغيرة كمون",
    "1/2 ملعقة صغيرة بابريكا",
    "ملح وفلفل حسب الذوق",
    "أعشاب طازجة للتزيين"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "في وعاء كبير، سخّن الزبدة أو الزيت على نار متوسطة."
    },
    {
      "@type": "HowToStep",
      "text": "أضف البصل والثوم، وقلّب حتى تفوح رائحتهما ويصبحان شفافين."
    },
    {
      "@type": "HowToStep",
      "text": "أضف الفلفل والجزر، واطبخ 5 دقائق حتى يطروا."
    },
    {
      "@type": "HowToStep",
      "text": "أضف البرغل والكمون والبابريكا وقلّب لتتغطى الحبوب بالزيت."
    },
    {
      "@type": "HowToStep",
      "text": "أضف مرق الخضار، اغله ثم خفف النار."
    },
    {
      "@type": "HowToStep",
      "text": "غطِّ القدر واتركه ينضج 15-20 دقيقة حتى ينضج البرغل ويمتص السائل."
    },
    {
      "@type": "HowToStep",
      "text": "ارفَع عن النار، اتركه مغطى 5 دقائق ثم فرّكه بالشوكة."
    },
    {
      "@type": "HowToStep",
      "text": "تبّل وزيّنه بالأعشاب الطازجة وقدّمه."
    }
  ]
}