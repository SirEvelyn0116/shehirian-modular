{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "بودينغ البرغل بالكرز",
  "author": "Shehirian family",
  "description": "حلوى بطبقات من البرغل وطبقة كرز وكاسترد مخبوز",
  "recipeCategory": "حلوى",
  "recipeCuisine": "عالمي",
  "recipeYield": "6-8 حصص",
  "prepTime": "PT20M",
  "cookTime": "PT1H",
  "totalTime": "PT1H20M",
  "recipeIngredient": [
    "2 كوب برغل مطبوخ ساخن",
    "2 ملعقة طعام زبدة أو مارجرين",
    "1/4 كوب سكر بني",
    "1/2 ملعقة صغيرة قرفة",
    "1-1/2 ملعقة طعام نشا الذرة",
    "1/4 كوب سكر",
    "عصير من علبة (450 جرام) كرز أحمر منزوع النوى",
    "1 ملعقة طعام عصير ليمون",
    "كرز مصفّى",
    "2 بيضات مخفوقة قليلاً",
    "1 كوب حليب",
    "3 ملعقة طعام سكر",
    "1/2 ملعقة صغيرة فانيلا"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "حضّر قاعدة البرغل بخلط البرغل المطبوخ الساخن مع الزبدة والسكر البني والقرفة في صينية خبز."
    },
    {
      "@type": "HowToStep",
      "text": "في قدر صغير، اخلط النشا والسكر، أضف عصير الكرز المصفّى واطبخ حتى يتثخن. أضف عصير الليمون ووزع الكرز المصفّى فوق البرغل."
    },
    {
      "@type": "HowToStep",
      "text": "اخفق البيض والحليب والسكر والفانيلا؛ اسكب فوق طبقة الكرز واخبز على حرارة 175°C لمدة ساعة أو حتى يتماسك الكاسترد."
    }
  ]
}