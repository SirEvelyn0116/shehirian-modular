{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "طاجن البرغل بالجبن",
  "author": "عائلة شيهريان",
  "description": "طاجن بسيط مخبوز يخلط البرغل المطبوخ مع الجبن والطماطم.",
  "recipeCategory": "طاجن",
  "recipeCuisine": "عالمي",
  "recipeYield": "4-6 حصص",
  "prepTime": "PT10M",
  "cookTime": "PT30M",
  "totalTime": "PT40M",
  "recipeIngredient": [
    "3 أكواب برغل مطبوخ",
    "1 علبة طماطم 425 جم",
    "1/3 كوب مشروم مقطع",
    "1/2 رطل جبن مصنّع شرائح",
    "2 ملعقة طعام فلفل أخضر مفروم",
    "2 ملعقة طعام بصل مفروم",
    "ملح وفلفل حسب الذوق"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "اخلط البرغل المطبوخ والمشروم والفلفل الأخضر والبصل والملح والفلفل."
    },
    {
      "@type": "HowToStep",
      "text": "ضع نصف الخليط في طاجن سطحي وغطّ بنصف شرائح الجبن."
    },
    {
      "@type": "HowToStep",
      "text": "أضف بقية الخليط، رتب شرائح الجبن المتبقية واخبز على 175°C لمدة 30 دقيقة."
    }
  ]
}