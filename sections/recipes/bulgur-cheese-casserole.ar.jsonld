{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "طاجن البرغل بالجبن",
  "description": "طاجن مخبوز بسيط يخلط البرغل المطبوخ مع الجبن والطماطم.",
  "author": { "@type": "Person", "name": "لورنس إيفلين" },
  "recipeCuisine": "عالمي",
  "recipeCategory": "طاجن",
  "recipeYield": "4-6 حصص",
  "prepTime": "PT10M",
  "cookTime": "PT30M",
  "totalTime": "PT40M",
  "recipeIngredient": [
    "3 أكواب برغل مطبوخ",
    "1 علبة طماطم 425 جم",
    "1/3 كوب مشروم مقطع",
    "نصف رطل جبن شرائح",
    "2 ملعقة طعام فلفل أخضر مفروم",
    "2 ملعقة طعام بصل مفروم",
    "ملح وفلفل حسب الذوق"
  ],
  "recipeInstructions": [
    "اخلط البرغل المطبوخ والمشروم والفلفل والبصل والملح والفلفل.",
    "ضع نصف الخليط في طاجن وغطِ بنصف شرائح الجبن.",
    "أضف بقية الخليط وضع الجبن المتبقي فوقه.",
    "اخبز على 175°C لمدة 30 دقيقة."
  ],
  "keywords": "طاجن,جبن,برغل"
}
