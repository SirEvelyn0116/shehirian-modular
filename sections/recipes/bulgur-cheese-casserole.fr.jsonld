{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Gratin de boulghour au fromage",
  "description": "Un gratin au four mélangeant du boulghour cuit avec du fromage et des tomates.",
  "author": { "@type": "Person", "name": "Laurence Evelyn" },
  "recipeCuisine": "Internationale",
  "recipeCategory": "Gratin",
  "recipeYield": "4-6 portions",
  "prepTime": "PT10M",
  "cookTime": "PT30M",
  "totalTime": "PT40M",
  "recipeIngredient": [
    "3 tasses de boulghour cuit",
    "1 boîte (425 g) de tomates",
    "1/3 tasse de champignons tranchés",
    "225 g de fromage en tranches",
    "2 c. à soupe de poivron vert haché",
    "2 c. à soupe d'oignon haché",
    "Sel et poivre au goût"
  ],
  "recipeInstructions": [
    "Mélanger le boulghour, les champignons, le poivron, l'oignon, le sel et le poivre.",
    "Déposer la moitié du mélange dans un plat et recouvrir de la moitié des tranches de fromage.",
    "Ajouter le reste et recouvrir du fromage restant.",
    "Cuire à 175°C pendant 30 minutes."
  ],
  "keywords": "gratin,fromage,boulghour"
}
