{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "فلفل محشو بالبرغل",
  "description": "فلفل محشو بخليط البرغل واللحم ومخبوز بصلصة الطماطم.",
  "author": { "@type": "Person", "name": "لورنس إيفلين" },
  "recipeCuisine": "عالمي",
  "recipeCategory": "طبق رئيسي",
  "recipeYield": "5-6 حصص",
  "prepTime": "PT20M",
  "cookTime": "PT1H10M",
  "totalTime": "PT1H30M",
  "recipeIngredient": [
    "2.5 كوب برغل مطبوخ",
    "نصف رطل لحم مفروم أو سجق",
    "1 كوب مرق دجاج أو لحم",
    "نصف ملعقة صغيرة ملح",
    "ربع ملعقة صغيرة ملح متبل",
    "1 ملعقة صغيرة صلصة ورشستر",
    "ربع ملعقة صغيرة فلفل",
    "3/4 كوب محضّر طماطم",
    "فلفل أخضر أو أحمر"
  ],
  "recipeInstructions": [
    "اخلط البرغل واللحم والمرق والملح والصلصة والفلفل.",
    "اقطع الفلفل إلى نصفين بالطول وأزل البذور.",
    "احشِ أنصاف الفلفل بخليط البرغل وضعها في طبق خبز.",
    "اسكب خليط صلصة الطماطم والمرق فوق الفلفل، غطِّ واخبز على 190°C لمدة 30 دقيقة ثم اكشف واخبز 40 دقيقة إضافية."
  ],
  "keywords": "فلفل محشو,برغل"
}
