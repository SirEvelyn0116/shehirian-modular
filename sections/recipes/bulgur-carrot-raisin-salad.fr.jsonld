{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Salade de bulgur aux carottes et raisins secs",
  "author": "Shehirian family",
  "description": "Une variation avec des raisins secs et une vinaigrette française pour une saveur sucrée et acidulée délicieuse.",
  "recipeCategory": "Salade",
  "recipeCuisine": "Américaine",
  "recipeYield": "8-10 portions",
  "prepTime": "PT10M",
  "cookTime": "PT15M",
  "totalTime": "PT25M",
  "recipeIngredient": [
    "2 tasses de boulghour cuit",
    "1 1/2 tasse de carottes râpées",
    "1/2 tasse de raisins secs",
    "1/2 tasse de vinaigrette (ou sauce française)",
    "Sel et poivre au goût"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Mélanger le boulghour cuit, les carottes râpées et les raisins secs dans un bol."
    },
    {
      "@type": "HowToStep",
      "text": "Ajouter la vinaigrette et mélanger."
    },
    {
      "@type": "HowToStep",
      "text": "Réfrigérer avant de servir."
    }
  ]
}