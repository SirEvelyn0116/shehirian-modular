{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "بيتزا بالبرغل",
  "author": "عائلة شيهريان",
  "description": "نسخة من البيتزا تستخدم البرغل في العجين وصلصة غنية باللحم والخضار.",
  "recipeCategory": "طبق رئيسي",
  "recipeCuisine": "عالمي",
  "recipeYield": "2 بيتزا (30 سم)",
  "prepTime": "PT1H15M",
  "cookTime": "PT40M",
  "totalTime": "PT1H55M",
  "recipeIngredient": [
    "صلصة: زيت، فلفل أخضر، بصل، فطر، ثوم، سجق إيطالي، لحم مفروم، معجون طماطم، صلصة طماطم، ماء، بارميزان، ورق غار، فلفل، ملح، زعتر",
    "العجين: 1/2 كوب برغل، 1-3/4 كوب ماء، خميرة جافة، دقيق، ملح، زيت",
    "التركيب: شرائح موزاريلا، جبن بارميزان مبشور"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "حضّر الصلصة: اقلي الخضار واللحوم، أضف معجون الطماطم والصلصة والماء والجبن والتوابل؛ اتركها تنضج 90 دقيقة."
    },
    {
      "@type": "HowToStep",
      "text": "حضّر العجين: اطبخ البرغل في الماء حتى يمتص، اتركه يبرد؛ اذب الخميرة وامزج مع الدقيق والبرغل والزيت؛ اتركه يختمر، قسمه وافرده لدوائر 30 سم."
    },
    {
      "@type": "HowToStep",
      "text": "ركّب بالجبن والصلصة واخبز على 190°C لمدة 35–40 دقيقة."
    }
  ]
}