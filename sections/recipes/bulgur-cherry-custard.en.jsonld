{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Bulgor Cherry Custard",
  "author": "Shehirian family",
  "description": "A layered Bulgor dessert with a cherry compote and baked custard.",
  "recipeCategory": "Dessert",
  "recipeCuisine": "International",
  "recipeYield": "6-8 servings",
  "prepTime": "",
  "cookTime": "PT1H",
  "totalTime": "PT1H20M",
  "recipeIngredient": [
    "2 cups hot cooked Bulgor",
    "2 tablespoons butter or margarine",
    "1/4 cup brown sugar",
    "1/2 teaspoon cinnamon",
    "1-1/2 tablespoons cornstarch",
    "1/4 cup sugar",
    "Juice from 1 can (1 lb.) red sour pitted cherries",
    "1 tablespoon lemon juice",
    "Drained cherries",
    "2 eggs, slightly beaten",
    "1 cup milk",
    "3 tablespoons sugar",
    "1/2 teaspoon vanilla"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Blend in a baking or pie dish: the cooked Bulgor, butter or margarine, brown sugar, and cinnamon."
    },
    {
      "@type": "HowToStep",
      "text": "In a saucepan, blend the cornstarch and sugar; stir in the juice drained from the cherries. Cook, stirring constantly, until thickened."
    },
    {
      "@type": "HowToStep",
      "text": "Stir in the lemon juice and drained cherries."
    },
    {
      "@type": "HowToStep",
      "text": "Layer on the Bulgor mixture."
    },
    {
      "@type": "HowToStep",
      "text": "Blend the slightly beaten eggs, milk, sugar, and vanilla."
    },
    {
      "@type": "HowToStep",
      "text": "Pour the egg mixture over the cherry mixture."
    },
    {
      "@type": "HowToStep",
      "text": "Bake in a moderate oven, 350°F, for 1 hour, or until the custard is set."
    }
  ]
}