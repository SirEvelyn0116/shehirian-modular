{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Raw Meat Platter",
  "author": "Shehirian family",
  "description": "A traditional seasoned raw lamb and Bulgor mixture served as patties.",
  "recipeCategory": "Starter",
  "recipeCuisine": "Middle Eastern",
  "recipeYield": "5-6 servings",
  "prepTime": "PT20M",
  "cookTime": "PT0M",
  "totalTime": "PT20M",
  "recipeIngredient": [
    "1 cup (about 1 lb.) lean lamb, ground twice",
    "Green pepper, chopped fine",
    "Parsley, chopped fine",
    "Green onions, chopped fine",
    "1-1/2 cups Bulgor wheat (fine)",
    "1 small onion, chopped fine",
    "Cayenne pepper (optional)",
    "Salt and pepper to taste"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Use lamb only (leg preferred) and serve same day it is ground."
    },
    {
      "@type": "HowToStep",
      "text": "Salt the meat and blend together."
    },
    {
      "@type": "HowToStep",
      "text": "Add Bulgor wheat, onions, a tablespoon of each green pepper, parsley, green onions and cayenne pepper if desired, and knead all together like dough, adding water a little at a time, until meat and Bulgor stick together, forming a smooth mixture (knead about 10 minutes)."
    },
    {
      "@type": "HowToStep",
      "text": "Shape into 2 inch patties and serve at once, garnished with the rest of chopped vegetables, after salting them to your taste."
    }
  ]
}