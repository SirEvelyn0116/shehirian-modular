{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Raw Meat Platter",
  "description": "A traditional seasoned raw lamb and bulgur mixture served as patties.",
  "author": { "@type": "Person", "name": "Laurence Evelyn" },
  "recipeCuisine": "Middle Eastern",
  "recipeCategory": "Starter",
  "recipeYield": "5-6 servings",
  "prepTime": "PT20M",
  "cookTime": "PT0M",
  "totalTime": "PT20M",
  "recipeIngredient": [
    "1 cup lean lamb, ground twice",
    "Green pepper, chopped fine",
    "Parsley, chopped fine",
    "Green onions, chopped fine",
    "1 cup bulgur wheat (fine)",
    "1 small onion, chopped fine",
    "Cayenne pepper (optional)",
    "Salt and pepper to taste"
  ],
  "recipeInstructions": [
    "Use lamb only (leg preferred) and serve the same day it is ground.",
    "Salt the meat and blend together.",
    "Add bulgur, chopped onions and vegetables and knead with a little water until mixture holds together.",
    "Shape into patties and serve immediately, garnished with chopped vegetables."
  ],
  "keywords": "raw meat,kibbeh-style,bulgur"
}
