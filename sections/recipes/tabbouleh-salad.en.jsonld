{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Tabbouleh Salad",
  "author": "Shehirian family",
  "description": "A refreshing Middle Eastern salad with bulgur wheat, fresh vegetables, and herbs.",
  "recipeCategory": "Salad",
  "recipeCuisine": "Middle Eastern",
  "recipeYield": "6 servings",
  "prepTime": "PT1H15M",
  "cookTime": "PT5M",
  "totalTime": "PT1H20M",
  "recipeIngredient": [
    "1/2 cup fine bulgur wheat",
    "2 cups finely chopped parsley",
    "1/2 cup finely chopped mint",
    "3 medium tomatoes, diced",
    "1/4 cup finely chopped onion",
    "1/4 cup fresh lemon juice",
    "1/4 cup olive oil",
    "Salt and pepper to taste"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Rinse bulgur and soak in cold water for 5 minutes then drain well."
    },
    {
      "@type": "HowToStep",
      "text": "In a large bowl combine parsley, mint, tomatoes and onion."
    },
    {
      "@type": "HowToStep",
      "text": "Add the drained bulgur and mix well."
    },
    {
      "@type": "HowToStep",
      "text": "Whisk together lemon juice, olive oil, salt and pepper; pour over salad and toss to combine."
    },
    {
      "@type": "HowToStep",
      "text": "Chill for at least 1 hour before serving to allow flavors to meld."
    }
  ]
}