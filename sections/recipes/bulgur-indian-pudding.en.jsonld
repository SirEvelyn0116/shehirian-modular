{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Bulgur Indian Pudding",
  "author": "Shehirian family",
  "description": "A molasses-sweet bulgur pudding spiced with cinnamon and ginger.",
  "recipeCategory": "Dessert",
  "recipeCuisine": "International",
  "recipeYield": "6 servings",
  "prepTime": "PT15M",
  "cookTime": "PT1H30M",
  "totalTime": "PT1H45M",
  "recipeIngredient": [
    "2-1/2 cups cooked bulgur",
    "1/2 teaspoon salt",
    "1/2 teaspoon cinnamon",
    "1/4 teaspoon ginger",
    "1/8 teaspoon cloves",
    "1/3 cup sugar",
    "1/2 cup molasses",
    "3 tablespoons butter",
    "1/2 cup raisins (optional)",
    "1 large can evaporated milk",
    "1-1/4 cups water"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Mix all ingredients in a 2-quart casserole."
    },
    {
      "@type": "HowToStep",
      "text": "Cover and bake in a slow oven (325°F / 160°C) for 45 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Remove cover and continue baking about 45 minutes until set."
    },
    {
      "@type": "HowToStep",
      "text": "Serve warm with whipped cream or ice cream."
    }
  ]
}