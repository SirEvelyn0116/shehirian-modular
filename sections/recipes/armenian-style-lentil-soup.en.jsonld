{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Armenian Style Lentil Soup",
  "author": "Shehirian family",
  "description": "An Armenian lentil soup with Bulgor wheat, parsley, mint, and a butter-fried onion garnish.",
  "recipeCategory": "Soup",
  "recipeCuisine": "Armenian",
  "recipeYield": "",
  "prepTime": "",
  "cookTime": "PT35M",
  "totalTime": "PT35M",
  "recipeIngredient": [
    "1/2 gallon water",
    "1/2 cup Bulgor wheat",
    "1/2 cup chopped parsley",
    "1/4 cup butter",
    "1/4 cup unpeeled whole lentils",
    "2 medium onions",
    "1/2 teaspoon dry mint, or 1 tablespoon fresh mint",
    "Salt and pepper"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Put lentils in water and bring to boil. Keep it boiling for 15 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Add Bulgor wheat, one onion sliced, parsley, salt and pepper, and cook for 20 minutes on moderate heat."
    },
    {
      "@type": "HowToStep",
      "text": "Meanwhile, chop the other onion and fry in butter until light brown."
    },
    {
      "@type": "HowToStep",
      "text": "Add mint 2 or 3 minutes before it is done, and pour over; mix and serve hot."
    }
  ]
}