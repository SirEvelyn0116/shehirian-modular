{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Թաբուլե Աղցան",
  "author": "Շահիրյան ընտանիք",
  "description": "Ուշացուցիչ Մերձավոր Արևելյան աղցան ձավարի ցորենով, թարմ բանջարեղենով և բույսերով։",
  "recipeCategory": "Աղցան",
  "recipeCuisine": "Մերձավոր Արևելյան",
  "recipeYield": "6 պորցիա",
  "prepTime": "PT1H15M",
  "cookTime": "PT5M",
  "totalTime": "PT1H20M",
  "recipeIngredient": [
    "1/2 բաժակ մանր ձավարի ցորեն",
    "2 բաժակ մանր կտրտած մաղադանոս",
    "1/2 բաժակ մանր կտրտած անանուխ",
    "3 միջին լոլիկ, կտրտած",
    "1/4 բաժակ մանր կտրտած սոխ",
    "1/4 բաժակ թարմ կիտրոնի հյութ",
    "1/4 բաժակ ձիթենի յուղ",
    "Աղ և պղպեղ ըստ համին"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Լվանալ ձավարը և թրևել սառն ջրում 5 րոպե, ապա լավ ցուցել։"
    },
    {
      "@type": "HowToStep",
      "text": "Մեծ ավանում խառնել մաղադանոս, անանուխ, լոլիկ և սոխ։"
    },
    {
      "@type": "HowToStep",
      "text": "Ավելացնել ցուցած ձավարը և լավ խառնել։"
    },
    {
      "@type": "HowToStep",
      "text": "Խառնել կիտրոնի հյութը, ձիթենի յուղը, աղը և պղպեղը. լցնել աղցանի վրա և խառնել։"
    },
    {
      "@type": "HowToStep",
      "text": "Սառնարանում պահել ոչ փոքր 1 ժամ մատուցելուց առաջ, որպեսզի համերն իրար համալրվեն։"
    }
  ]
}