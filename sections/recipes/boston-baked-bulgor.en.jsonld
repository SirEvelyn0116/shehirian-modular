{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Boston Baked Bulgur",
  "author": "Shehirian family",
  "description": "A sweet-and-savory baked bulgur dish finished with bacon or salt pork.",
  "recipeCategory": "Casserole",
  "recipeCuisine": "American",
  "recipeYield": "4-5 servings",
  "prepTime": "PT10M",
  "cookTime": "PT1H25M",
  "totalTime": "PT1H35M",
  "recipeIngredient": [
    "2-1/2 cups cooked bulgur wheat",
    "2/3 cup condensed tomato soup",
    "3 tablespoons molasses",
    "3/4 cup water or consommé",
    "3 tablespoons brown sugar",
    "1/2 teaspoon dry mustard",
    "1/2 teaspoon salt",
    "1 to 2 tablespoons minced onion",
    "1 teaspoon Worcestershire sauce",
    "2 ounces salt pork or bacon"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Blend all ingredients except salt pork or bacon in a casserole."
    },
    {
      "@type": "HowToStep",
      "text": "Cut salt pork or bacon into strips and press into surface of bulgur mixture."
    },
    {
      "@type": "HowToStep",
      "text": "Cover and bake at 325°F (160°C) for 45 minutes; remove cover and continue baking about 40 minutes."
    }
  ]
}