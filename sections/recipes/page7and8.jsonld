{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Recipe",
      "name": "Raw Meat Platter",
      "recipeYield": "5 to 6 servings",
      "recipeIngredient": [
        "1 cup (about 1 lb.) lean lamb, ground twice",
        "Green pepper, chopped fine",
        "Parsley, chopped fine",
        "Green onions, chopped fine",
        "1 cup Bulgor wheat (fine)",
        "1 small onion, chopped fine",
        "Cayenne pepper (optional)",
        "Salt and pepper to taste"
      ],
      "recipeInstructions": [
        {
          "@type": "HowToStep",
          "text": "Use lamb only (leg preferred) and serve same day it is ground. Salt the meat and blend together."
        },
        {
          "@type": "HowToStep",
          "text": "Add Bulgor wheat, onions, a tablespoon of each green pepper, parsley, green onions and cayenne pepper if desired."
        },
        {
          "@type": "HowToStep",
          "text": "Knead all together like dough adding water a little at a time until meat and Bulgor stick together, forming a smooth mixture (knead about 10 minutes)."
        },
        {
          "@type": "HowToStep",
          "text": "Shape into 2 inch patties and serve at once, garnished with the rest of chopped vegetables, after salting them to your taste."
        }
      ]
    },
    {
      "@type": "Recipe",
      "name": "Bulgor Stuffed Peppers",
      "recipeYield": "5 to 6 servings",
      "recipeIngredient": [
        "2-1/2 cups cooked Bulgor wheat",
        "1/2 pound ground fresh or left-over meat or sausage",
        "1 cup meat or chicken stock or canned bouillon",
        "1/2 teaspoon salt",
        "1/4 teaspoon seasoned salt",
        "1 teaspoon Worcestershire sauce",
        "1/4 teaspoon pepper",
        "3/4 cup tomato purée",
        "Green or red bell peppers"
      ],
      "recipeInstructions": [
        {
          "@type": "HowToStep",
          "text": "Blend together Bulgor, meat or sausage, one cup bouillon or meat stock, salt, seasoned salt, Worcestershire sauce, and pepper."
        },
        {
          "@type": "HowToStep",
          "text": "Cut peppers in halves lengthwise, remove all seeds and white portions."
        },
        {
          "@type": "HowToStep",
          "text": "Fill pepper halves with Bulgor mixture and place in shallow baking dish."
        },
        {
          "@type": "HowToStep",
          "text": "Mix tomato purée and 3/4 cup meat stock and pour over stuffed peppers."
        },
        {
          "@type": "HowToStep",
          "text": "Cover and bake in moderately hot oven, 375°F, 30 minutes. Remove cover and continue baking for 40 minutes."
        }
      ]
    },
    {
      "@type": "Recipe",
      "name": "Bulgor Meat Loaf",
      "recipeYield": "10 to 12 servings",
      "recipeIngredient": [
        "2-1/2 cups cooked Bulgor wheat",
        "1 egg",
        "1-1/4 cups milk",
        "2 teaspoons salt",
        "1/4 teaspoon pepper",
        "1/4 to 1/2 cup chopped onion",
        "1/4 cup ketchup",
        "2 pounds ground beef"
      ],
      "recipeInstructions": [
        {
          "@type": "HowToStep",
          "text": "Blend all ingredients together."
        },
        {
          "@type": "HowToStep",
          "text": "Turn into loaf pan or shape into loaf in shallow baking dish. If you wish, spread surface with thin layer of ketchup."
        },
        {
          "@type": "HowToStep",
          "text": "Bake in moderate oven, 325°F, about 1 hour or until browned."
        }
      ]
    },
    {
      "@type": "Recipe",
      "name": "Bulgor Salmon Loaf",
      "recipeYield": "6 to 8 servings",
      "recipeIngredient": [
        "2-1/2 cups cooked Bulgor wheat",
        "1 can (16 oz.) salmon, drained",
        "2 eggs",
        "1/2 cup liquid (salmon liquid plus milk)",
        "1/4 cup chopped onion",
        "2 tablespoons lemon juice",
        "2 tablespoons pickle relish",
        "1/4 teaspoon salt",
        "1/4 teaspoon pepper"
      ],
      "recipeInstructions": [
        {
          "@type": "HowToStep",
          "text": "Blend all ingredients. Turn into loaf pan and bake in moderate oven, 350°F, 3/4 to 1 hour."
        }
      ]
    },
    {
      "@type": "Recipe",
      "name": "Cabbage Rolls",
      "recipeIngredient": [
        "Cabbage leaves",
        "1-1/2 cups ground lamb",
        "2 small onions chopped fine",
        "1-1/2 cups Bulgor wheat",
        "3 tablespoons tomato paste",
        "2 tablespoons chopped parsley",
        "1/2 teaspoon mint (dry)",
        "Salt and pepper to taste",
        "3 cups meat broth or water",
        "Juice of 1/2 lemon"
      ],
      "recipeInstructions": [
        {
          "@type": "HowToStep",
          "text": "Soften the cabbage leaves in boiling water and cut off the ribs. Boil 4 to 5 minutes, rinse with cold water, squeeze gently."
        },
        {
          "@type": "HowToStep",
          "text": "Mix Bulgor, meat, parsley, mint, chopped onions, tomato paste, salt and pepper."
        },
        {
          "@type": "HowToStep",
          "text": "Spread a leaf, put filling near stem end, fold sides, and roll up."
        },
        {
          "@type": "HowToStep",
          "text": "Arrange rolls in pan. Fill with 3 cups meat broth or water and lemon juice."
        },
        {
          "@type": "HowToStep",
          "text": "Cover and cook or bake with moderate heat for 1 hour."
        }
      ]
    },
    {
      "@type": "Recipe",
      "name": "Fish and Bulgor Pilaf",
      "recipeYield": "6 to 8 servings",
      "recipeIngredient": [
        "3 tablespoons butter or margarine",
        "1 pound fresh salmon, cut in cubes or strips",
        "1/2 cup chopped onion",
        "1/2 cup chopped celery",
        "1 cup Bulgor wheat",
        "2 cups water",
        "1 to 2 tablespoons lemon juice",
        "1 teaspoon salt",
        "1/8 teaspoon fine herbs",
        "1/8 teaspoon (scant) thyme"
      ],
      "recipeInstructions": [
        {
          "@type": "HowToStep",
          "text": "Heat butter or margarine in skillet, add onion and celery. Sauté until onions are straw-coloured."
        },
        {
          "@type": "HowToStep",
          "text": "Add rest of the ingredients, cover and simmer 25 to 30 minutes."
        }
      ]
    }
  ]
}