{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Bulgur Stuffed Peppers",
  "description": "Bell peppers stuffed with a bulgur and meat mixture, baked in tomato sauce.",
  "author": { "@type": "Person", "name": "Laurence Evelyn" },
  "recipeCuisine": "International",
  "recipeCategory": "Main Dish",
  "recipeYield": "5-6 servings",
  "prepTime": "PT20M",
  "cookTime": "PT1H10M",
  "totalTime": "PT1H30M",
  "recipeIngredient": [
    "2-1/2 cups cooked bulgur",
    "1/2 pound ground meat or sausage",
    "1 cup meat or chicken stock",
    "1/2 teaspoon salt",
    "1/4 teaspoon seasoned salt",
    "1 teaspoon Worcestershire sauce",
    "1/4 teaspoon pepper",
    "3/4 cup tomato purée",
    "Green or red bell peppers"
  ],
  "recipeInstructions": [
    "Blend bulgur, meat, stock, salt, seasoned salt, Worcestershire sauce and pepper.",
    "Cut peppers in halves lengthwise and remove seeds.",
    "Fill pepper halves with bulgur mixture and place in baking dish.",
    "Pour tomato purée mixed with stock over peppers, cover and bake at 375°F for 30 minutes, then uncover and bake an additional 40 minutes."
  ],
  "keywords": "stuffed peppers,bulgur"
}
