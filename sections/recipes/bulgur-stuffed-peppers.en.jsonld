{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Bulgor Stuffed Peppers",
  "author": "Shehirian family",
  "description": "Bell peppers stuffed with a Bulgor and meat mixture, baked in tomato sauce.",
  "recipeCategory": "Main Dish",
  "recipeCuisine": "International",
  "recipeYield": "5 to 6 servings",
  "prepTime": "",
  "cookTime": "PT1H10M",
  "totalTime": "PT1H10M",
  "recipeIngredient": [
    "2-1/2 cups cooked Bulgor wheat",
    "1/2 pound ground fresh or left-over meat or sausage",
    "1-3/4 cup meat or chicken stock or canned bouillon",
    "1/2 teaspoon salt",
    "1 teaspoon seasoned salt",
    "1/4 teaspoon Worcestershire sauce",
    "1/4 teaspoon pepper",
    "3/4 cup tomato purée",
    "3 green or red bell peppers"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Blend together Bulgor, meat or sausage, one cup bouillon or meat stock, salt, seasoned salt, Worcestershire sauce, and pepper."
    },
    {
      "@type": "HowToStep",
      "text": "Cut peppers in halves lengthwise and remove all seeds and white portions."
    },
    {
      "@type": "HowToStep",
      "text": "Fill pepper halves with Bulgor mixture and place in shallow baking dish."
    },
    {
      "@type": "HowToStep",
      "text": "Mix tomato purée and 3/4 cup meat stock and pour over peppers, cover and bake at 375°F for 30 minutes, then uncover and bake an additional 40 minutes."
    }
  ]
}