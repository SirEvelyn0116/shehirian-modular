{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Bulgor Carrot Pineapple Salad",
  "author": "Shehirian family",
  "description": "A sweet and savory salad combining Bulgor wheat with shredded carrots and tropical pineapple.",
  "recipeCategory": "Salad",
  "recipeCuisine": "American",
  "recipeYield": "4 to 6 servings",
  "prepTime": "",
  "cookTime": "",
  "totalTime": "",
  "recipeIngredient": [
    "1-1/2 cups cooked Bulgor",
    "2 tablespoons pineapple juice",
    "1-1/2 cups shredded carrots",
    "1/2 cup drained crushed pineapple",
    "1/2 cup mayonnaise",
    "1/2 teaspoon salt"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Blend Bulgor and pineapple juice."
    },
    {
      "@type": "HowToStep",
      "text": "Chill."
    },
    {
      "@type": "HowToStep",
      "text": "Add remaining ingredients and mix well."
    },
    {
      "@type": "HowToStep",
      "text": "Chill."
    },
    {
      "@type": "HowToStep",
      "text": "Serve in lettuce cups."
    }
  ]
}