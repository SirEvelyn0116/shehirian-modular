{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Armenian Pilaf",
  "description": "A light pilaf with vermicelli and bulgur cooked in chicken stock.",
  "author": { "@type": "Person", "name": "Laurence Evelyn" },
  "recipeCuisine": "Armenian",
  "recipeCategory": "Side Dish",
  "recipeYield": "4-6 servings",
  "prepTime": "PT5M",
  "cookTime": "PT20M",
  "totalTime": "PT25M",
  "recipeIngredient": [
    "2 tbsp butter or margarine",
    "3 tbsp chopped onion",
    "1/2 cup vermicelli or noodles",
    "1 cup bulgur wheat",
    "2 cups chicken stock",
    "3/4 tsp salt",
    "1/8 tsp pepper"
  ],
  "recipeInstructions": [
    "Heat butter in skillet and sauté onion and vermicelli until lightly browned.",
    "Add bulgur, chicken stock, salt and pepper; cover and simmer 20 minutes until liquid is absorbed.",
    "Let stand 15-20 minutes before serving."
  ],
  "keywords": "armenian,pilaf,bulgur"
}
