  "name": "بيلاف لحم على الطريقة الهندية",
  "description": "بيلاف لحم متبّل بالكاري والتفاح مع البرغل.",
  "author": { "@type": "Person", "name": "لورنس إيفلين" },
  "recipeCuisine": "من الطراز الهندي",
