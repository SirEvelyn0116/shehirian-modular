{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "بيلاف لحم على الطريقة الهندية",
  "author": "عائلة شيهريان",
  "description": "بيلاف لحم متبّل بالكاري والتفاح مع البرغل.",
  "recipeCategory": "طبق رئيسي",
  "recipeCuisine": "من الطراز الهندي",
  "recipeYield": "5-6 حصص",
  "prepTime": "PT15M",
  "cookTime": "PT40M",
  "totalTime": "PT55M",
  "recipeIngredient": [
    "زيت، مكعبات لحم مطبوخة، بصل مفروم، تفاح حامض، ثوم، بذور كرفس، مسحوق كاري، زنجبيل، ملح، فلفل، تاباسكو، معجون طماطم، مرق أو ماء، 1 كوب برغل"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "اقلِّ اللحم مع البصل والتفاح والثوم؛ حمّر قليلًا."
    },
    {
      "@type": "HowToStep",
      "text": "اخلط بقية المكونات، اغلي ثم اتركها تغلي بهدوء حوالي 40 دقيقة حتى تتكثف."
    }
  ]
}