{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Pilaf Almondine",
  "author": "Շահիրյան ընտանիք",
  "description": "A simple ձավարի ցորեն pilaf garnished with toasted almonds and poppy seeds.",
  "recipeCategory": "Կողային ուտեստ",
  "recipeCuisine": "Միջազգային",
  "recipeYield": "4 to 5 պորցիա",
  "prepTime": "PT5M",
  "cookTime": "PT25M",
  "totalTime": "PT35M",
  "recipeIngredient": [
    "1 բաժակ ձավարի ցորեն Wheat",
    "2 բաժակs ջուր",
    "1/2 բաժակ կարագ or margarine",
    "1/4 թեյի գդալ աղ",
    "Chopped toasted almonds (for garnish)",
    "Poppy seeds (for garnish)"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Combine ձավարի ցորեն, աղ, and ջուր in a saucepan."
    },
    {
      "@type": "HowToStep",
      "text": "Bring to bձեթ, add կարագ or margarine, cover, reduce heat and simmer until ջուր is absorbed (15 to 20 minutes)."
    },
    {
      "@type": "HowToStep",
      "text": "Let it stand 10 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Sprinkle each serving lightly with poppy seeds and 1 to 2 թեյի գդալs chopped toasted almonds."
    }
  ]
}