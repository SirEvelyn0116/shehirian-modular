{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Fish and Bulgur Pilaf",
  "author": "Shehirian family",
  "description": "A bulgur pilaf flavored with sautéed vegetables and chunks of salmon.",
  "recipeCategory": "Main Dish",
  "recipeCuisine": "International",
  "recipeYield": "6-8 servings",
  "prepTime": "PT10M",
  "cookTime": "PT30M",
  "totalTime": "PT40M",
  "recipeIngredient": [
    "3 tablespoons butter or margarine",
    "1 pound fresh salmon, cubed",
    "1/2 cup chopped onion",
    "1/2 cup chopped celery",
    "1 cup bulgur wheat",
    "2 cups water",
    "1-2 tablespoons lemon juice",
    "1 teaspoon salt",
    "1/8 teaspoon fine herbs",
    "1/8 teaspoon thyme"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Heat butter in skillet, add onion and celery and sauté until translucent."
    },
    {
      "@type": "HowToStep",
      "text": "Add salmon and cook briefly, then add bulgur and water."
    },
    {
      "@type": "HowToStep",
      "text": "Cover and simmer 25-30 minutes until bulgur is tender. Season with lemon juice and salt."
    }
  ]
}