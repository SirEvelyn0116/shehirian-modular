{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Fish and Bulgor Pilaf",
  "author": "Shehirian family",
  "description": "A Bulgor pilaf flavored with sautéed vegetables and chunks of salmon.",
  "recipeCategory": "Main Dish",
  "recipeCuisine": "International",
  "recipeYield": "6 to 8 servings",
  "prepTime": "",
  "cookTime": "",
  "totalTime": "",
  "recipeIngredient": [
    "3 tablespoons butter or margarine",
    "1 pound fresh salmon, cut in cubes or strips",
    "1/2 cup chopped onion",
    "1/2 cup chopped celery",
    "1 cup Bulgor wheat",
    "2 cups water",
    "1 to 2 tablespoons lemon juice",
    "1 teaspoon salt",
    "1/8 teaspoon fine herbs",
    "1/8 teaspoon (scant) thyme"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Heat butter or margarine in skillet, add onion and celery."
    },
    {
      "@type": "HowToStep",
      "text": "Sauté until onions are straw-coloured."
    },
    {
      "@type": "HowToStep",
      "text": "Add rest of the ingredients, cover and simmer 25 to 30 minutes."
    }
  ]
}