{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Scotch Broth with Bulgor Wheat",
  "author": "Shehirian family",
  "description": "A Scottish lamb and vegetable broth with Bulgor wheat, thickened with a butter-and-flour roux.",
  "recipeCategory": "Soup",
  "recipeCuisine": "Scottish",
  "recipeYield": "6 to 8 servings",
  "prepTime": "",
  "cookTime": "",
  "totalTime": "",
  "recipeIngredient": [
    "2-1/2 quarts water",
    "2 pounds lamb shanks",
    "1 cup diced or shredded carrots",
    "1/2 cup chopped onion or leeks",
    "1 cup sliced celery",
    "1 cup Bulgor wheat",
    "1/4 cup snipped parsley",
    "2 to 3 teaspoons salt",
    "1/4 teaspoon pepper",
    "1/2 teaspoon curry powder (optional)",
    "2 tablespoons butter or margarine",
    "4 tablespoons flour"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Simmer lamb shanks in water 2 to 3 hours, then remove meat and bones and skin off all fat."
    },
    {
      "@type": "HowToStep",
      "text": "Add Bulgor wheat, carrots, onion or leeks, celery, parsley, salt and pepper, and curry power; cover and continue cooking until vegetables are tender, 15 to 20 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Remove meat from bones, dice, and return to soup mixture."
    },
    {
      "@type": "HowToStep",
      "text": "Blend together over low heat: butter and flour."
    },
    {
      "@type": "HowToStep",
      "text": "Slowly stir in about 2 cups of the soup mixture, then stir into remaining soup mixture."
    },
    {
      "@type": "HowToStep",
      "text": "Continue cooking until thickened, about 3 minutes."
    }
  ]
}