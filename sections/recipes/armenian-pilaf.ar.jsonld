{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "بيلاف أرمني",
  "description": "بيلاف خفيف مع شعيرية وبرغل مطبوخ في مرق الدجاج.",
  "author": { "@type": "Person", "name": "لورنس إيفلين" },
  "recipeCuisine": "أرمينية",
  "recipeCategory": "طبق جانبي",
  "recipeYield": "4-6 حصص",
  "prepTime": "PT5M",
  "cookTime": "PT20M",
  "totalTime": "PT25M",
  "recipeIngredient": [
    "2 ملعقة طعام زبدة أو مارجرين",
    "3 ملعقة طعام بصل مفروم",
    "1/2 كوب شعيرية أو نودلز",
    "1 كوب برغل",
    "2 كوب مرق دجاج",
    "3/4 ملعقة صغيرة ملح",
    "1/8 ملعقة صغيرة فلفل"
  ],
  "recipeInstructions": [
    "سخّن الزبدة، قلي البصل والشعيرية حتى تصفر قليلًا.",
    "أضف البرغل ومرق الدجاج والملح والفلفل؛ غط واتركه يغلي على نار هادئة 20 دقيقة.",
    "اتركه 15-20 دقيقة قبل التقديم."
  ],
  "keywords": "أرميني,بيلاف,برغل"
}
