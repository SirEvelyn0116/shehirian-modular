{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "بيلاف أرمني",
  "author": "Shehirian family",
  "description": "بيلاف خفيف مع شعيرية وبرغل مطبوخ في مرق الدجاج.",
  "recipeCategory": "طبق جانبي",
  "recipeCuisine": "أرمينية",
  "recipeYield": "4-6 حصص",
  "prepTime": "PT5M",
  "cookTime": "PT20M",
  "totalTime": "PT25M",
  "recipeIngredient": [
    "2 ملعقة طعام زبدة أو مارجرين",
    "3 ملعقة طعام بصل مفروم",
    "1/2 كوب شعيرية أو نودلز",
    "1 كوب برغل",
    "2 كوب مرق دجاج",
    "3/4 ملعقة صغيرة ملح",
    "1/8 ملعقة صغيرة فلفل"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "سخّن الزبدة، قلي البصل والشعيرية حتى تحمر قليلاً."
    },
    {
      "@type": "HowToStep",
      "text": "أضف البرغل ومرق الدجاج والملح والفلفل؛ غط واتركه ينضج 20 دقيقة حتى يمتص السائل."
    },
    {
      "@type": "HowToStep",
      "text": "اتركه 15-20 دقيقة قبل التقديم."
    }
  ]
}