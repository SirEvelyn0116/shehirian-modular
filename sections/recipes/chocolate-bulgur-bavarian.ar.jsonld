{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "بافاريا الشوكولاتة بالبرغل",
  "author": "Shehirian family",
  "description": "حلوى شوكولاتة وبرغل مبردة مع الجيلاتين والكريم",
  "recipeCategory": "حلوى",
  "recipeCuisine": "عالمي",
  "recipeYield": "6-8 حصص",
  "prepTime": "PT30M",
  "cookTime": "PT0M",
  "totalTime": "PT2H30M",
  "recipeIngredient": [
    "1 عبوة جيلاتين",
    "2 ملعقة طعام ماء",
    "2.5 ملعقة طعام كاكاو",
    "3/4 كوب سكر",
    "1.5 كوب حليب",
    "1.5 كوب برغل مطبوخ",
    "1 ملعقة صغيرة فانيلا",
    "1/2 كوب كريمة ثقيلة مخفوقة"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "اذب الجيلاتين في الماء وسخّن مع الكاكاو والسكر والحليب حتى يذوب (لا تغلِ)."
    },
    {
      "@type": "HowToStep",
      "text": "أضف البرغل المطبوخ والفانيلا، برد حتى يثخن ولكن ليس جامداً."
    },
    {
      "@type": "HowToStep",
      "text": "اطوِّ الكريمة المخفوقة، اسكب في قالب مدهون بالزيت وبرّده حتى يتماسك."
    }
  ]
}