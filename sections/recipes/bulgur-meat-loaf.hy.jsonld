{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "ձավարի ցորեն Meat Loaf",
  "author": "Շահիրյան ընտանիք",
  "description": "A meatloaf enriched with ձավարի ցորեն wheat and baked until browned.",
  "recipeCategory": "Հիմնական ուտեստ",
  "recipeCuisine": "Միջազգային",
  "recipeYield": "10-12 պորցիա",
  "prepTime": "PT15M",
  "cookTime": "PT1H",
  "totalTime": "PT1H15M",
  "recipeIngredient": [
    "2-1/2 բաժակ եփած ձավար",
    "1 ձու",
    "1-1/4 բաժակ կաթ",
    "2 թեյի գդալ աղ",
    "1/4 թեյի գդալ պղպեղ",
    "1/4 to 1/2 բաժակ մանրացված սոխ",
    "1/4 բաժակ ketchup",
    "2 ֆունտ աղացած տավարի միս"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Blend all ingկարմիրients together."
    },
    {
      "@type": "HowToStep",
      "text": "Turn into պիրոգ տապակ and թխել at 325°f (160°c) about 1 ժամ or until շագանակագույն դարձնելed."
    },
    {
      "@type": "HowToStep",
      "text": "Optionally քսել a thin layer of ketchup on top before baking."
    }
  ]
}