{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "حساء ملكي",
  "author": "عائلة شيهريان",
  "description": "حساء شرق أوسطي بكرات اللحم والليمون مع الأرز والبقدونس.",
  "recipeCategory": "شوربة",
  "recipeCuisine": "شرق أوسطية",
  "recipeYield": "ست حصص",
  "prepTime": "PT15M",
  "cookTime": "PT30M",
  "totalTime": "PT45M",
  "recipeIngredient": [
    "نصف جالون مرق دجاج",
    "نصف رطل لحم بقري مفروم (غير قليل الدهن)",
    "ربع كوب أرز نيء",
    "ربع كوب بصل مفروم ناعم جدًا",
    "ربع كوب بقدونس",
    "ربع كوب عصير ليمون",
    "ربع كوب كرفس مفروم ناعم",
    "ربع ملعقة صغيرة ملح",
    "شرائح من 2 ليمون"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "اخلط اللحم النيء والبرغل والبصل والبقدونس والتوابل معًا وشكّل كرات بقطر 2.5 سم."
    },
    {
      "@type": "HowToStep",
      "text": "أضف الأرز إلى خليط كرات اللحم."
    },
    {
      "@type": "HowToStep",
      "text": "أضف كرات اللحم إلى مرق الدجاج الساخن واتركها تغلي حتى تنضج."
    },
    {
      "@type": "HowToStep",
      "text": "أضف عصير الليمون والكرفس واتركه يغلي لمدة 10 دقائق."
    },
    {
      "@type": "HowToStep",
      "text": "أضف الملح وشرائح الليمون واتركه يغلي لمدة 5 دقائق."
    },
    {
      "@type": "HowToStep",
      "text": "اضبط الحموضة أو الملوحة أو السماكة باستخدام السكر أو الماء أو الأرز حسب الحاجة."
    },
    {
      "@type": "HowToStep",
      "text": "اسكب المرق فوق كرات اللحم وقدّم."
    }
  ]
}