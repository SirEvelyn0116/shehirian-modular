{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Scotch Haggis with Bulgor",
  "author": "Shehirian family",
  "description": "A traditional haggis-style pudding mixed with Bulgor.",
  "recipeCategory": "Pudding",
  "recipeCuisine": "Scottish",
  "recipeYield": "",
  "prepTime": "",
  "cookTime": "",
  "totalTime": "",
  "recipeIngredient": [
    "3 lamb hearts",
    "1 lb liver",
    "1/2 lb minced suet",
    "1/2 cup chopped onions",
    "1 cup Bulgor wheat",
    "3 tsp salt",
    "2 cups meat broth or bouillon"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Simmer lamb hearts and liver in water 1.5 hours; cool and grind."
    },
    {
      "@type": "HowToStep",
      "text": "Add suet, onions, Bulgor, salt and broth; mix well and steam in covered pudding mold 3 hours."
    }
  ]
}