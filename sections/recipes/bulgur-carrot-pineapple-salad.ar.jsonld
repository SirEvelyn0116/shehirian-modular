{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "سلطة البرغل بالجزر والأناناس",
  "author": "عائلة شيهريان",
  "description": "سلطة حلوة ومالحة تجمع بين البرغل والجزر المبشور والأناناس الاستوائي.",
  "recipeCategory": "سلطة",
  "recipeCuisine": "أمريكية",
  "recipeYield": "8-10 حصص",
  "prepTime": "PT10M",
  "cookTime": "PT15M",
  "totalTime": "PT25M",
  "recipeIngredient": [
    "2 كوب برغل مطبوخ ومبرد",
    "2 كوب جزر مبشور",
    "1 كوب قطع أناناس (طازج أو معلب)",
    "1/4 كوب مايونيز",
    "1 ملعقة طعام عصير ليمون",
    "1 ملعقة طعام سكر (اختياري)",
    "ملح وفلفل حسب الذوق"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "اطبخ البرغل حسب التعليمات، ودعه يبرد إلى درجة حرارة الغرفة."
    },
    {
      "@type": "HowToStep",
      "text": "في وعاء كبير اخلط البرغل والجزر المبشور والأناناس."
    },
    {
      "@type": "HowToStep",
      "text": "اخلط المايونيز وعصير الليمون والسكر والملح والفلفل ثم اخلطها مع السلطة."
    },
    {
      "@type": "HowToStep",
      "text": "ضعها في الثلاجة قبل التقديم."
    }
  ]
}