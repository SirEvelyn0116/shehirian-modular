{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "بيلاف السمك والبرغل",
  "author": "عائلة شيهريان",
  "description": "بيلاف برغل بنكهة الخضار والسلمون.",
  "recipeCategory": "طبق رئيسي",
  "recipeCuisine": "عالمي",
  "recipeYield": "6-8 حصص",
  "prepTime": "PT10M",
  "cookTime": "PT30M",
  "totalTime": "PT40M",
  "recipeIngredient": [
    "3 ملعقة طعام زبدة أو سمن",
    "1 رطل سلمون طازج، مقطع مكعبات",
    "1/2 كوب بصل مفروم",
    "1/2 كوب كرفس مفروم",
    "1 كوب برغل",
    "2 كوب ماء",
    "1-2 ملعقة طعام عصير ليمون",
    "1 ملعقة صغيرة ملح",
    "1/8 ملعقة صغيرة أعشاب ناعمة",
    "1/8 ملعقة صغيرة زعتر"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "سخّن الزبدة في مقلاة، أضف البصل والكرفس وقلِّب حتى يذبلا."
    },
    {
      "@type": "HowToStep",
      "text": "أضف السلمون واطبخ قليلاً، ثم أضف البرغل والماء."
    },
    {
      "@type": "HowToStep",
      "text": "غطِّ واتركه على نار هادئة 25-30 دقيقة حتى ينضج البرغل. تبّل بعصير الليمون والملح."
    }
  ]
}