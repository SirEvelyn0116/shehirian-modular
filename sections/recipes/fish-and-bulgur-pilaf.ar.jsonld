{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "بيلاف السمك والبرغل",
  "description": "بيلاف برغل بنكهة الخضار والسلمون.",
  "author": { "@type": "Person", "name": "لورنس إيفلين" },
  "recipeCuisine": "عالمي",
  "recipeCategory": "طبق رئيسي",
  "recipeYield": "6-8 حصص",
  "prepTime": "PT10M",
  "cookTime": "PT30M",
  "totalTime": "PT40M",
  "recipeIngredient": [
    "3 ملعقة طعام زبدة أو سمن",
    "1 رطل سلمون طازج، مقطع مكعبات",
    "1/2 كوب بصل مفروم",
    "1/2 كوب كرفس مفروم",
    "1 كوب برغل",
    "2 كوب ماء",
    "1-2 ملعقة طعام عصير ليمون",
    "1 ملعقة صغيرة ملح",
    "1/8 ملعقة صغيرة أعشاب ناعمة",
    "1/8 ملعقة صغيرة زعتر"
  ],
  "recipeInstructions": [
    "سخّن الزبدة في مقلاة، أضف البصل والكرفس وقلِّب حتى يذبلا.",
    "أضف السلمون واطبخ قليلاً، ثم أضف البرغل والماء.",
    "غطِّ واتركه على نار هادئة 25-30 دقيقة حتى ينضج البرغل. تبّل بعصير الليمون والملح."
  ],
  "keywords": "بيلاف سمك,برغل"
}
