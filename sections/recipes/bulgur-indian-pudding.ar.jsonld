{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "بودينغ برغل على الطريقة الهندية",
  "author": "Shehirian family",
  "description": "بودينغ برغل بالدبس والبهارات",
  "recipeCategory": "حلوى",
  "recipeCuisine": "عالمي",
  "recipeYield": "6 حصص",
  "prepTime": "PT15M",
  "cookTime": "PT1H30M",
  "totalTime": "PT1H45M",
  "recipeIngredient": [
    "2.5 كوب برغل مطبوخ",
    "1/2 ملعقة صغيرة ملح",
    "1/2 ملعقة صغيرة قرفة",
    "1/4 ملعقة صغيرة زنجبيل",
    "1/8 ملعقة صغيرة قرنفل",
    "1/3 كوب سكر",
    "1/2 كوب دبس",
    "3 ملعقة كبيرة زبدة",
    "1/2 كوب زبيب (اختياري)",
    "1 علبة كبيرة لبن مبخر",
    "1 1/4 كوب ماء"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "اخلط جميع المكونات في طبق خبز سعة 2 لتر."
    },
    {
      "@type": "HowToStep",
      "text": "غطِّ واخبز في فرن منخفض الحرارة (160°C) لمدة 45 دقيقة."
    },
    {
      "@type": "HowToStep",
      "text": "أزل الغطاء واستمر في الخبز حوالي 45 دقيقة حتى يتماسك."
    },
    {
      "@type": "HowToStep",
      "text": "قدّمه دافئًا مع كريمة مخفوقة أو آيس كريم."
    }
  ]
}