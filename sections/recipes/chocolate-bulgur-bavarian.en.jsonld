{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Chocolate Bulgor Bavarian",
  "author": "Shehirian family",
  "description": "A chilled chocolate and Bulgor dessert set with gelatin and folded cream.",
  "recipeCategory": "Dessert",
  "recipeCuisine": "International",
  "recipeYield": "6-8 servings",
  "prepTime": "",
  "cookTime": "",
  "totalTime": "",
  "recipeIngredient": [
    "1 package (1 tbsp.) gelatin",
    "2 tablespoons water",
    "2-1/2 tablespoons cocoa",
    "3/4 cup sugar",
    "1-1/2 cups milk",
    "1-1/2 cups cooked Bulgor",
    "1 teaspoon vanilla",
    "1/2 cup heavy cream, whipped"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Dissolve gelatin in water and heat with cocoa, sugar and milk until dissolved, stirring frequently. Do not boil."
    },
    {
      "@type": "HowToStep",
      "text": "Stir in cooked bulgur and vanilla, chill until thick but not firm."
    },
    {
      "@type": "HowToStep",
      "text": "Fold in whipped cream, turn into a mould which has been brushed with salad oil, and chill until firm. Unmould and garnish, if you wish, with whipped cream and a few candied cherries."
    }
  ]
}