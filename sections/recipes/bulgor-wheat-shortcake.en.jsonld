{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Bulgor Wheat Shortcake",
  "author": "Shehirian family",
  "description": "A shortcake-style dessert or accompaniment using cooked bulgur in the dough.",
  "recipeCategory": "Side Dish",
  "recipeCuisine": "Baked",
  "recipeYield": "6 to 8 servings",
  "prepTime": "PT15M",
  "cookTime": "PT50M",
  "totalTime": "PT65M",
  "recipeIngredient": [
    "1 cup water",
    "1/4 cup Bulgor wheat",
    "2 cups sifted flour",
    "3-1/2 teaspoons baking powder",
    "3/4 teaspoon salt",
    "1/3 cup sugar",
    "1/4 cup shortening",
    "3/4 cup milk"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Combine water and Bulgor wheat; cover and simmer about 20 minutes until most water is absorbed."
    },
    {
      "@type": "HowToStep",
      "text": "Sift together flour, baking powder, salt, and sugar."
    },
    {
      "@type": "HowToStep",
      "text": "Cut in shortening, stir in cooked Bulgor and milk, pat into greased 8-inch cake pan."
    },
    {
      "@type": "HowToStep",
      "text": "Brush surface lightly with milk, sprinkle with sugar and bake at 400°F about 30 minutes. Top with whipped cream and fruit."
    }
  ]
}