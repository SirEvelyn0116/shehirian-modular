{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "سلطة الحديقة بالبرغل",
  "author": "عائلة شيهريان",
  "description": "سلطة حديقة متعددة الاستخدامات مع البرغل والخضروات الطازجة والبيض المسلوق — مثالية كطبق جانبي أو رئيسي.",
  "recipeCategory": "سلطة",
  "recipeCuisine": "أمريكية",
  "recipeYield": "8 حصص",
  "prepTime": "PT15M",
  "cookTime": "PT15M",
  "totalTime": "PT30M",
  "recipeIngredient": [
    "2 كوب برغل مطبوخ",
    "1 كوب خضروات مفرومة متنوعة (طماطم، خيار، فلفل)",
    "2 بيض مسلوق، مقطع شرائح",
    "1/4 كوب زيت زيتون",
    "2 ملعقة طعام عصير ليمون",
    "ملح وفلفل حسب الذوق",
    "بقدونس طازج للتزيين"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "اطبخ البرغل واتركه يبرد."
    },
    {
      "@type": "HowToStep",
      "text": "اخلط الخضروات المفرومة وشرائح البيض في وعاء."
    },
    {
      "@type": "HowToStep",
      "text": "أضف البرغل وقلّب بلطف."
    },
    {
      "@type": "HowToStep",
      "text": "اخلط زيت الزيتون وعصير الليمون والملح والفلفل واسكبها على السلطة وقلّب."
    },
    {
      "@type": "HowToStep",
      "text": "ضعها في الثلاجة لفترة قصيرة قبل التقديم."
    }
  ]
}