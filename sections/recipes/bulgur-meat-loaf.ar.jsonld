{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "رغيف لحم بالبرغل",
  "author": "Shehirian family",
  "description": "رغيف لحم مخلوط بالبرغل ومخبوز حتى يتحمر.",
  "recipeCategory": "طبق رئيسي",
  "recipeCuisine": "عالمي",
  "recipeYield": "10-12 حصص",
  "prepTime": "PT15M",
  "cookTime": "PT1H",
  "totalTime": "PT1H15M",
  "recipeIngredient": [
    "2.5 كوب برغل مطبوخ",
    "1 بيضة",
    "1.25 كوب حليب",
    "2 ملعقة صغيرة ملح",
    "1/4 ملعقة صغيرة فلفل",
    "1/4 إلى 1/2 كوب بصل مفروم",
    "1/4 كوب كاتشب",
    "2 رطل لحم بقري مفروم"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "اخلط جميع المكونات معًا."
    },
    {
      "@type": "HowToStep",
      "text": "ضع في قالب رغيف واخبز عند 160°C لمدة ساعة تقريبًا أو حتى يتحمر."
    },
    {
      "@type": "HowToStep",
      "text": "اختياري: ضع طبقة رقيقة من الكاتشب على السطح قبل الخبز."
    }
  ]
}