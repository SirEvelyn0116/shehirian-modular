  "recipeIngredient": [
    "2.5 كوب برغل مطبوخ",
    "1 بيضة",
    "1.25 كوب حليب",
    "2 ملعقة صغيرة ملح",
    "1/4 ملعقة صغيرة فلفل",
    "1/4 إلى 1/2 كوب بصل مفروم",
    "1/4 كوب كاتشب",
    "2 رطل لحم بقري مفروم"
