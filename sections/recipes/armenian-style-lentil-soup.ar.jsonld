{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "حساء العدس على الطريقة الأرمنية",
  "author": "عائلة شيهريان",
  "description": "حساء أرمني غني بالعدس والبقدونس والنعناع والزبدة.",
  "recipeCategory": "شوربة",
  "recipeCuisine": "أرمنية",
  "recipeYield": "أربع حصص",
  "prepTime": "PT15M",
  "cookTime": "PT60M",
  "totalTime": "PT75M",
  "recipeIngredient": [
    "نصف كوب ماء",
    "نصف كوب عدس",
    "نصف كوب بصل مفروم",
    "نصف كوب بقدونس مفروم",
    "نصف ملعقة صغيرة ملح",
    "نصف ملعقة صغيرة فلفل",
    "نصف كوب زبدة أو سمن",
    "نصف كوب نعناع مفروم"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "اغلِ العدس في الماء لمدة 15 دقيقة."
    },
    {
      "@type": "HowToStep",
      "text": "أضف البصل والبقدونس والملح والفلفل واتركه يغلي لمدة 45 دقيقة."
    },
    {
      "@type": "HowToStep",
      "text": "أضف النعناع والزبدة واتركه يغلي لمدة 15 دقيقة."
    },
    {
      "@type": "HowToStep",
      "text": "أضف ربع ملعقة صغيرة فلفل واطهِ لمدة 5 دقائق."
    },
    {
      "@type": "HowToStep",
      "text": "اختياري: اقْلِ الزبدة حتى تصبح بنية فاتحة ثم اسكبها فوق الحساء."
    }
  ]
}