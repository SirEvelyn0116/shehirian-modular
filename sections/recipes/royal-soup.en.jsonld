{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Royal Soup",
  "author": "Shehirian family",
  "description": "A Middle Eastern egg-and-lemon meatball soup with Bulgor wheat and parsley.",
  "recipeCategory": "Soup",
  "recipeCuisine": "Middle Eastern",
  "recipeYield": "",
  "prepTime": "PT10M",
  "cookTime": "PT15M",
  "totalTime": "PT25M",
  "recipeIngredient": [
    "1/2 gallon chicken broth",
    "1/2 lb. ground lamb, not too lean",
    "1 cup Bulgor wheat (fine)",
    "1/4 cup very finely chopped onion",
    "1/4 cup finely chopped parsley",
    "3 eggs",
    "Juice of 2 lemons",
    "Salt and pepper"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Mix raw meat, Bulgor wheat, onion, parsley and seasoning together, and knead well, adding water a little at a time until mixture is smooth (about 10 minutes)."
    },
    {
      "@type": "HowToStep",
      "text": "Make mixture into small balls about the size of cherries, drop them into the boiling chicken broth and cook for 15 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Beat eggs thoroughly, adding lemon juice while beating."
    },
    {
      "@type": "HowToStep",
      "text": "Slowly pour the soup broth into the egg and lemon mixture, beating constantly, until all the broth has been used."
    },
    {
      "@type": "HowToStep",
      "text": "Pour over the balls and serve immediately."
    }
  ]
}