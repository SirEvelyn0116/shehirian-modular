{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "برغل بالواينرز",
  "author": "Shehirian family",
  "description": "طبق برغل كريمي مخبوز يعلوه سجق (واينرز).",
  "recipeCategory": "طاجن",
  "recipeCuisine": "طعام مريح",
  "recipeYield": "5-6 حصص",
  "prepTime": "PT10M",
  "cookTime": "PT50M",
  "totalTime": "PT1H",
  "recipeIngredient": [
    "2.5 كوب برغل مطبوخ",
    "1 بيضة مخفوقة قليلاً",
    "2 ملعقة طعام بصل مفروم",
    "1 علبة حساء كريمي بالفطر مركز",
    "1/2 ملعقة صغيرة ملح",
    "3/4 كوب حليب",
    "5-6 نقانق"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "اخلط البرغل والبيضة والبصل والحساء المركز والملح والحليب في طبق خبز سطحي."
    },
    {
      "@type": "HowToStep",
      "text": "اخبز على 175°C حتى يتماسك جزئياً (~30 دقيقة)."
    },
    {
      "@type": "HowToStep",
      "text": "ضع النقانق، ادهنها بالمارغرين واستمر في الخبز 15-20 دقيقة حتى تتحمر."
    }
  ]
}