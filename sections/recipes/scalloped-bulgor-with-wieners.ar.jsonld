{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "برغل بالواينرز",
  "description": "طاجن برغل كريمي مخبوز يعلوه نقانق.",
  "author": { "@type": "Person", "name": "لورنس إيفلين" },
  "recipeCategory": "طاجن",
  "recipeYield": "5-6 حصص",
  "prepTime": "PT10M",
  "cookTime": "PT50M",
  "totalTime": "PT1H",
  "recipeIngredient": [
    "2.5 كوب برغل مطبوخ",
    "1 بيضة",
    "2 ملعقة طعام بصل مفروم",
    "1 علبة حساء كريمي بالفطر مركّز",
    "1/2 ملعقة صغيرة ملح",
    "3/4 كوب حليب",
    "5-6 نقانق"
  ],
  "recipeInstructions": [
    "اخلط البرغل والبيضة والبصل والحساء المركز والملح والحليب في طبق خبز.",
    "اخبز على 175°C حتى يتماسك جزئياً (~30 دقيقة).",
    "ضع النقانق، ادهنها بالمرغرين واستمر في الخبز 15–20 دقيقة حتى تتحمر."
  ],
  "keywords": "طاجن,نقانق,برغل"
}
