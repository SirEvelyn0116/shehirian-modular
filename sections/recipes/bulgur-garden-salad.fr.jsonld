{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Salade jardinière au bulgur",
  "author": "Famille Shehirian",
  "description": "Une salade de jardin polyvalente avec du blé bulgur, des légumes frais et des œufs durs — parfaite comme accompagnement ou plat principal.",
  "recipeCategory": "Salade",
  "recipeCuisine": "Américaine",
  "recipeYield": "8 portions",
  "prepTime": "PT15M",
  "cookTime": "PT15M",
  "totalTime": "PT30M",
  "recipeIngredient": [
    "2 tasses de boulghour cuit",
    "1 tasse de légumes hachés mélangés (tomate, concombre, poivron)",
    "2 œufs durs, tranchés",
    "1/4 tasse d'huile d'olive",
    "2 c. à soupe de jus de citron",
    "Sel et poivre au goût",
    "Persil frais pour garnir"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Cuire le boulghour et laisser refroidir."
    },
    {
      "@type": "HowToStep",
      "text": "Mélanger les légumes hachés et les œufs tranchés dans un bol."
    },
    {
      "@type": "HowToStep",
      "text": "Ajouter le boulghour et mélanger délicatement."
    },
    {
      "@type": "HowToStep",
      "text": "Fouetter l'huile d'olive, le jus de citron, le sel et le poivre; verser sur la salade et mélanger."
    },
    {
      "@type": "HowToStep",
      "text": "Réfrigérer brièvement avant de servir."
    }
  ]
}