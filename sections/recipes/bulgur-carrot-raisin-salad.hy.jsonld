{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "ձավարի ցորեն գազար Raisin Salad",
  "author": "Շահիրյան ընտանիք",
  "description": "A variation with չամիչ and french dressing for a delightful sweet and tangy flavor.",
  "recipeCategory": "Աղցան",
  "recipeCuisine": "Ամերիկյան",
  "recipeYield": "8-10 պորցիա",
  "prepTime": "PT10M",
  "cookTime": "PT15M",
  "totalTime": "PT25M",
  "recipeIngredient": [
    "2 բաժակ եփած ձավար ցորեն",
    "1 1/2 բաժակ shկարմիրded գազարs",
    "1/2 բաժակ չամիչ",
    "1/2 բաժակ french dressing (or vinaigrette)",
    "Աղ and պղպեղ to taste"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Խառնել եփած ձավար, shկարմիրded գազարs, and չամիչ in a bowl."
    },
    {
      "@type": "HowToStep",
      "text": "Ավելացնել french dressing and toss to coat."
    },
    {
      "@type": "HowToStep",
      "text": "Chill before պորցիա."
    }
  ]
}