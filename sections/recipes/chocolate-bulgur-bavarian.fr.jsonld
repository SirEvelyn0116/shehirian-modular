{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Bavarois chocolat au boulghour",
  "author": "Laurence Evelyn",
  "description": "Un dessert chocolaté au boulghour, pris à la gélatine et à la crème fouettée.",
  "recipeCategory": "Dessert",
  "recipeCuisine": "Internationale",
  "recipeYield": "6-8 portions",
  "prepTime": "PT30M",
  "cookTime": "PT0M",
  "totalTime": "PT2H30M",
  "recipeIngredient": [
    "1 sachet de gélatine",
    "2 cuillères à soupe d'eau",
    "2 1/2 cuillères à soupe de cacao",
    "3/4 tasse de sucre",
    "1 1/2 tasse de lait",
    "1 1/2 tasse de boulghour cuit",
    "1 cuillère à café de vanille",
    "1/2 tasse de crème épaisse, fouettée"
  ],
  "recipeInstructions": [
    { "@type": "HowToStep", "text": "Dissoudre la gélatine dans l'eau et chauffer avec le cacao, le sucre et le lait jusqu'à dissolution (ne pas bouillir)." },
    { "@type": "HowToStep", "text": "Ajouter le boulghour cuit et la vanille, refroidir jusqu'à épaississement sans prise complète." },
    { "@type": "HowToStep", "text": "Incorporer la crème fouettée, verser dans un moule graissé et réfrigérer jusqu'à ce que ça prenne." }
  ]
}
