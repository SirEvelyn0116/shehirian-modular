{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Steamed Bulgor Fruit Pudding",
  "author": "Shehirian family",
  "description": "A steamed loaf-style fruit pudding with Bulgor and dried fruits.",
  "recipeCategory": "Dessert",
  "recipeCuisine": "International",
  "recipeYield": "about 12 servings",
  "prepTime": "",
  "cookTime": "PT2H",
  "totalTime": "PT2H30M",
  "recipeIngredient": [
    "1-1/4 cups sifted all-purpose flour",
    "2 teaspoons baking powder",
    "1/2 teaspoon salt",
    "1/2 cup butter or shortening",
    "1-1/4 cups sugar",
    "2 eggs",
    "1-1/2 cups cooked Bulgor",
    "1 teaspoon vanilla",
    "1/2 cup dried prunes (pitted), ground",
    "1/2 cup raisins, ground",
    "1/4 cup dried apricots, ground",
    "1 cup milk"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Sift together the flour, baking powder, and salt."
    },
    {
      "@type": "HowToStep",
      "text": "Cream the butter and sugar until light and fluffy."
    },
    {
      "@type": "HowToStep",
      "text": "Add the eggs; beat until thick and creamy."
    },
    {
      "@type": "HowToStep",
      "text": "Stir in the cooked Bulgor and vanilla."
    },
    {
      "@type": "HowToStep",
      "text": "Grind together the prunes, raisins, and apricots; stir into the Bulgor mixture."
    },
    {
      "@type": "HowToStep",
      "text": "Add the milk alternately with the dry ingredients."
    },
    {
      "@type": "HowToStep",
      "text": "Fill a greased loaf pan or mould three-fourths full (coffee or shortening cans will do)."
    },
    {
      "@type": "HowToStep",
      "text": "Cover tightly. Steam 2 hours. Serve with whipped cream."
    },
    {
      "@type": "HowToStep",
      "text": "Any large covered utensil with a tight cover can be used as a steamer. Place a rack in the bottom and keep the water level at about 1-1/2 inches. Keep the water boiling gently."
    }
  ]
}