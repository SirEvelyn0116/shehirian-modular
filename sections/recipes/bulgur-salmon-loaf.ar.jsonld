  "name": "رغيف السلمون بالبرغل",
  "description": "رغيف سلمون ممزوج بالبرغل ومخبوز حتى يستوي.",
  "author": { "@type": "Person", "name": "لورنس إيفلين" },
  "recipeCuisine": "عالمي",
  "recipeCategory": "طبق رئيسي",
  "recipeYield": "6-8 حصص",
  "prepTime": "PT15M",
  "cookTime": "PT45M",
  "totalTime": "PT1H",
  "recipeIngredient": [
    "2.5 كوب برغل مطبوخ",
    "1 علبة (450 جم) سلمون، مصفّى",
    "2 بيض",
    "1/2 كوب سائل (عصارة السلمون + حليب)",
    "1/4 كوب بصل مفروم",
    "2 ملعقة طعام عصير ليمون",
    "2 ملعقة طعام مخلل مفروم",
    "1/4 ملعقة صغيرة ملح",
    "1/4 ملعقة صغيرة فلفل"
  ],
  "recipeInstructions": [
    "اخلط جميع المكونات واسكبها في قالب رغيف.",
    "اخبز في فرن معتدل 175°C لمدة 45 دقيقة حتى ينضج."
  ],
  "keywords": "رغيف سلمون,برغل"
