{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "محشي الكرنب",
  "author": "Shehirian family",
  "description": "أوراق الكرنب المحشوة بخليط البرغل واللحم المطهو حتى النعومة.",
  "recipeCategory": "طبق رئيسي",
  "recipeCuisine": "شرق أوسطية",
  "recipeYield": "تكفي عدة حصص",
  "prepTime": "PT30M",
  "cookTime": "PT1H",
  "totalTime": "PT1H30M",
  "recipeIngredient": [
    "أوراق كرنب",
    "1.5 كوب لحم ضأن مفروم",
    "2 بصلات صغيرة مفرومة ناعماً",
    "1.5 كوب برغل",
    "3 ملعقة طعام معجون طماطم",
    "2 ملعقة طعام بقدونس مفروم",
    "1/2 ملعقة صغيرة نعناع مجفف",
    "ملح وفلفل حسب الذوق",
    "3 كوب مرق لحم أو ماء",
    "عصير نصف ليمونة"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "نقّع أوراق الكرنب في ماء مغلي وقلّم الأعناق."
    },
    {
      "@type": "HowToStep",
      "text": "اخلط البرغل مع اللحم والبصل ومعجون الطماطم والبقدونس والنعناع والملح والفلفل."
    },
    {
      "@type": "HowToStep",
      "text": "ضع الحشوة على الأوراق، لفّها ورتبها في القدر؛ أضف المرق وعصير الليمون."
    },
    {
      "@type": "HowToStep",
      "text": "غطّ واطبخ أو اخبز على حرارة معتدلة لمدة ساعة."
    }
  ]
}