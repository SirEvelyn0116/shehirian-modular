{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Boulghour frit à la chinoise",
  "description": "Un boulghour sauté rapide à la sauce soja et légumes, servi en accompagnement ou plat principal.",
  "author": { "@type": "Person", "name": "Laurence Evelyn" },
  "recipeCuisine": "Inspiré chinois",
  "recipeCategory": "Plat/Accompagnement",
  "recipeYield": "4-5 portions",
  "prepTime": "PT5M",
  "cookTime": "PT15M",
  "totalTime": "PT20M",
  "recipeIngredient": [
    "2 c. à soupe d'huile",
    "3/4 tasse d'oignon finement haché",
    "1/2 tasse de poivron vert finement haché",
    "1/2 tasse de céleri finement haché",
    "2 1/2 tasses de boulghour cuit",
    "2 c. à soupe de sauce soja"
  ],
  "recipeInstructions": [
    "Chauffer l'huile et faire revenir l'oignon, le poivron et le céleri jusqu'à transparence.",
    "Ajouter le boulghour et la sauce soja; couvrir et cuire 15 minutes à feu doux en remuant de temps en temps."
  ],
  "keywords": "boulghour frit,soja,légumes"
}
