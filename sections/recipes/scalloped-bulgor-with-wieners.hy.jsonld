{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Scalloped ձավարի ցորեն with Wieners",
  "author": "Շահիրյան ընտանիք",
  "description": "A creamy baked ձավարի ցորեն dish topped with wieners.",
  "recipeCategory": "Casserole",
  "recipeCuisine": "Comfort Food",
  "recipeYield": "5-6 պորցիա",
  "prepTime": "PT10M",
  "cookTime": "PT50M",
  "totalTime": "PT1H",
  "recipeIngredient": [
    "2-1/2 բաժակ եփած ձավար",
    "1 ձու slightly ծեծելen",
    "2 ճաշի գդալ մանրացված սոխ",
    "1 can condensed սերուցք of mushroom ապուր",
    "1/2 թեյի գդալ աղ",
    "3/4 բաժակ կաթ",
    "5-6 սոսիսներ"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Խառնել ձավար, ձու, սոխ, condensed ապուր, աղ and կաթ in shallow թխման աման."
    },
    {
      "@type": "HowToStep",
      "text": "Թխել at 350°f (175°c) until partially set (~30 րոպե)."
    },
    {
      "@type": "HowToStep",
      "text": "Top with սոսիսներ, brush with մարգարին and continue baking 15–20 րոպե until շագանակագույն դարձնելed."
    }
  ]
}