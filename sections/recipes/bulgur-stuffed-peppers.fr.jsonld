{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Poivrons farcis au boulghour",
  "author": "Shehirian family",
  "description": "Poivrons farcis d'un mélange de boulghour et viande, cuits au four dans une sauce tomate.",
  "recipeCategory": "Plat principal",
  "recipeCuisine": "Internationale",
  "recipeYield": "5-6 portions",
  "prepTime": "PT20M",
  "cookTime": "PT1H10M",
  "totalTime": "PT1H30M",
  "recipeIngredient": [
    "2 1/2 tasses de boulghour cuit",
    "1/2 livre de viande hachée ou saucisse",
    "1 tasse de bouillon de poulet ou de viande",
    "1/2 c. à thé de sel",
    "1/4 c. à thé de sel assaisonné",
    "1 c. à thé de sauce Worcestershire",
    "1/4 c. à thé de poivre",
    "3/4 tasse de purée de tomate",
    "Poivrons verts ou rouges"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Mélanger le boulghour, la viande, le bouillon, le sel, la sauce Worcestershire et le poivre."
    },
    {
      "@type": "HowToStep",
      "text": "Couper les poivrons en deux dans le sens de la longueur et retirer les graines."
    },
    {
      "@type": "HowToStep",
      "text": "Remplir les moitiés de poivron et placer dans un plat à four."
    },
    {
      "@type": "HowToStep",
      "text": "Verser la purée de tomate mélangée au bouillon, couvrir et cuire à 190°C pendant 30 minutes, puis découvrir et poursuivre 40 minutes."
    }
  ]
}