{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Poivrons farcis au boulghour",
  "description": "Poivrons farcis d'un mélange de boulghour et viande, cuits au four dans une sauce tomate.",
  "author": { "@type": "Person", "name": "Laurence Evelyn" },
  "recipeCuisine": "Internationale",
  "recipeCategory": "Plat principal",
  "recipeYield": "5-6 portions",
  "prepTime": "PT20M",
  "cookTime": "PT1H10M",
  "totalTime": "PT1H30M",
  "recipeIngredient": [
    "2 1/2 tasses de boulghour cuit",
    "1/2 livre de viande hachée ou saucisse",
    "1 tasse de bouillon de poulet ou de viande",
    "1/2 c. à thé de sel",
    "1/4 c. à thé de sel assaisonné",
    "1 c. à thé de sauce Worcestershire",
    "1/4 c. à thé de poivre",
    "3/4 tasse de purée de tomate",
    "Poivrons verts ou rouges"
  ],
  "recipeInstructions": [
    "Mélanger le boulghour, la viande, le bouillon, le sel, la sauce Worcestershire et le poivre.",
    "Couper les poivrons en deux dans le sens de la longueur et retirer les graines.",
    "Remplir les moitiés de poivron et placer dans un plat à four.",
    "Verser la purée de tomate mélangée au bouillon, couvrir et cuire à 190°C pendant 30 minutes, puis découvrir et poursuivre 40 minutes."
  ],
  "keywords": "poivrons farcis,boulghour"
}
