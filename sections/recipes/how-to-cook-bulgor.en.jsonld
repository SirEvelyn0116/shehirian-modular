{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "How to Cook Bulgor",
  "author": "Shehirian family",
  "description": "The basic method for cooking dry Bulgor wheat, used as a prepared ingredient in other recipes in this collection.",
  "recipeCategory": "Basics",
  "recipeCuisine": "",
  "recipeYield": "2 1/2 cups",
  "prepTime": "",
  "cookTime": "",
  "totalTime": "",
  "recipeIngredient": [
    "1 cup dry Bulgor wheat",
    "1-2/3 cups water",
    "1/4 teaspoon salt"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Combine in a saucepan: dry Bulgor wheat, water, and salt."
    },
    {
      "@type": "HowToStep",
      "text": "Bring to boil, cover, reduce heat, and simmer until water is absorbed."
    }
  ]
}