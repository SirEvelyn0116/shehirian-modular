{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Persian Pilaf",
  "description": "A traditional Persian-style pilaf with lamb and bulgur.",
  "author": { "@type": "Person", "name": "Laurence Evelyn" },
  "recipeCuisine": "Persian",
  "recipeCategory": "Main Dish",
  "recipeYield": "8-10 servings",
  "prepTime": "PT20M",
  "cookTime": "PT1H",
  "totalTime": "PT1H20M",
  "recipeIngredient": [
    "Shoulder of lamb, cubed",
    "Chopped onion",
    "Chopped tomatoes",
    "Bulgur",
    "Butter",
    "Broth or water",
    "Salt and pepper"
  ],
  "recipeInstructions": [
    "Braise lamb cubes until well browned; add onions and tomatoes and cook 15 minutes.",
    "Cook bulgur briefly in boiling broth, drain and place over meat; put butter in center and pour broth around edges.",
    "Bake in moderate oven about 1 hour; turn onto platter and serve hot unmixed."
  ],
  "keywords": "persian,pilaf,bulgur"
}
