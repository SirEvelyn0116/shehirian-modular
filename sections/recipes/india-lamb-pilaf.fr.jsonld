{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Pilaf d'agneau à l'indienne",
  "description": "Un pilaf d'agneau épicé au curry et aux pommes, avec du boulghour.",
  "author": { "@type": "Person", "name": "Laurence Evelyn" },
  "recipeCuisine": "Inspiré indien",
  "recipeCategory": "Plat principal",
  "recipeYield": "5-6 portions",
  "prepTime": "PT15M",
  "cookTime": "PT40M",
  "totalTime": "PT55M",
  "recipeIngredient": [
    "Huile, cubes d'agneau cuits, oignon haché, pomme acidulée, ail, graines de céleri, curry, gingembre, sel, poivre, Tabasco, purée de tomate, consommé ou eau, boulghour"
  ],
  "recipeInstructions": [
    "Faire revenir l'agneau avec l'oignon, la pomme et l'ail; dorer légèrement.",
    "Incorporez le reste des ingrédients, portez à ébullition puis laissez mijoter environ 40 minutes jusqu'à épaississement."
  ],
  "keywords": "pilaf d'agneau,curry,boulghour"
}
