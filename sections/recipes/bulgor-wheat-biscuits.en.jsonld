{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Bulgor Wheat Biscuits",
  "author": "Shehirian family",
  "description": "Tender biscuits made with cooked Bulgor mixed into the dough.",
  "recipeCategory": "Side Dish",
  "recipeCuisine": "Baked",
  "recipeYield": "10 to 12 (2 inch) biscuits",
  "prepTime": "",
  "cookTime": "",
  "totalTime": "",
  "recipeIngredient": [
    "1 cup water",
    "1/4 cup Bulgor wheat",
    "2 cups sifted flour",
    "3-1/2 teaspoons baking powder",
    "1 teaspoon salt",
    "1/4 cup shortening",
    "3/4 cup milk",
    "3/4 cup cooked Bulgor"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Combine water and Bulgor wheat; cover and simmer about 20 minutes until most water is absorbed. Do not boil."
    },
    {
      "@type": "HowToStep",
      "text": "Sift together flour, baking powder, and salt; cut in shortening with a pastry blender until the shortening is finely distributed."
    },
    {
      "@type": "HowToStep",
      "text": "Stir in milk and cooked Bulgor. Turn out on lightly floured paper. Knead about 10 times. Pat or roll out about 1/2-inch thick. Cut with a floured biscuit cutter or knife into 2-inch squares."
    },
    {
      "@type": "HowToStep",
      "text": "Bake at 400°F until lightly browned, about 25 to 30 minutes."
    }
  ]
}