{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Cabbage Rolls",
  "author": "Shehirian family",
  "description": "Cabbage leaves stuffed with a Bulgor and lamb filling, simmered until tender.",
  "recipeCategory": "Main Dish",
  "recipeCuisine": "Middle Eastern",
  "recipeYield": "Serves many",
  "prepTime": "PT30M",
  "cookTime": "PT1H",
  "totalTime": "PT1H30M",
  "recipeIngredient": [
    "Cabbage leaves",
    "1-1/2 cups ground lamb",
    "2 small onions, chopped fine",
    "1-1/2 cups bulgur",
    "3 tablespoons tomato paste",
    "2 tablespoons chopped parsley",
    "1/2 teaspoon dried mint",
    "Salt and pepper to taste",
    "3 cups meat broth or water",
    "Juice of 1/2 lemon"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Soften cabbage leaves in boiling water and trim ribs."
    },
    {
      "@type": "HowToStep",
      "text": "Mix bulgur with lamb, onions, tomato paste, parsley, mint, salt and pepper."
    },
    {
      "@type": "HowToStep",
      "text": "Place filling on cabbage leaves, roll and arrange in pan; add broth and lemon juice."
    },
    {
      "@type": "HowToStep",
      "text": "Cover and cook or bake at moderate heat for 1 hour."
    }
  ]
}