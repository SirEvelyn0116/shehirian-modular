{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Cabbage Rolls",
  "author": "Shehirian family",
  "description": "Cabbage leaves stuffed with a Bulgor and lamb filling, simmered until tender.",
  "recipeCategory": "Main Dish",
  "recipeCuisine": "Middle Eastern",
  "recipeYield": "",
  "prepTime": "",
  "cookTime": "PT1H",
  "totalTime": "PT1H",
  "recipeIngredient": [
    "Cabbage leaves",
    "1-1/2 cups (3/4 lb.) ground lamb",
    "2 small onions, chopped fine",
    "1-1/2 cups Bulgor wheat",
    "3 tablespoons tomato paste",
    "2 tablespoons chopped parsley",
    "1/2 teaspoon mint (dry)",
    "Salt and pepper to taste",
    "About 3 cups meat broth or water (or to an inch below the surface)",
    "Juice of 1/2 lemon"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Soften the cabbage leaves in boiling water and cut off the ribs."
    },
    {
      "@type": "HowToStep",
      "text": "Put this back in boiling water and boil 4 to 5 minutes; take out, rinse with cold water, and squeeze the water out gently."
    },
    {
      "@type": "HowToStep",
      "text": "Add Bulgor to the meat and mix; add parsley, mint, chopped onions, tomato paste, salt and pepper, and blend together."
    },
    {
      "@type": "HowToStep",
      "text": "Spread a leaf on a small plate, wrong side up, with the stem end toward you."
    },
    {
      "@type": "HowToStep",
      "text": "Put some filling (according to the size of the leaf) near the stem end; with your hands, fold over the sides, then start rolling from the stem up like a cigarette."
    },
    {
      "@type": "HowToStep",
      "text": "Cover the bottom of the pan with some leaves, then arrange the stuffed rolls side by side."
    },
    {
      "@type": "HowToStep",
      "text": "Fill with meat broth or water (about 3 cups, or an inch below the surface); add the juice of 1/2 lemon to the water."
    },
    {
      "@type": "HowToStep",
      "text": "Put on the lid and cook or bake with moderate heat for 1 hour. Best if served hot."
    }
  ]
}