{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Chinese Fried Bulgur",
  "author": "Shehirian family",
  "description": "A quick fried bulgur with soy sauce and vegetables, served as a side or main.",
  "recipeCategory": "Main/Side",
  "recipeCuisine": "Chinese-Inspired",
  "recipeYield": "4-5 servings",
  "prepTime": "PT5M",
  "cookTime": "PT15M",
  "totalTime": "PT20M",
  "recipeIngredient": [
    "2 tbsp oil",
    "3/4 cup finely minced onion",
    "1/2 cup finely minced green bell pepper",
    "1/2 cup finely minced celery",
    "2-1/2 cups cooked bulgur",
    "2 tbsp soy sauce"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Heat oil in skillet, sauté onion, bell pepper and celery until translucent."
    },
    {
      "@type": "HowToStep",
      "text": "Stir in cooked bulgur and soy sauce; cover and cook over low heat 15 minutes, stirring occasionally."
    }
  ]
}