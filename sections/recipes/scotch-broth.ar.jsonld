{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "مرق اسكتلندي بالبرغل",
  "author": "Shehirian family",
  "description": "حساء اسكتلندي تقليدي معدّل بالبرغل الشهي ولحم الخروف.",
  "recipeCategory": "حساء",
  "recipeCuisine": "اسكتلندية",
  "recipeYield": "6-8 حصص",
  "prepTime": "PT15M",
  "cookTime": "PT105M",
  "totalTime": "PT120M",
  "recipeIngredient": [
    "2 lbs. lamb shoulder",
    "8 cups water",
    "1/2 cup bulgur wheat",
    "1 cup diced carrots",
    "1 cup diced turnip",
    "1 cup chopped leeks",
    "1/2 cup pearl barley",
    "Salt and pepper to taste",
    "Fresh parsley for garnish",
    "2 quarts chicken broth",
    "2 pounds lamb shank",
    "1 cup chopped parsley",
    "1/2 cup chopped onion",
    "1/2 cup chopped carrots",
    "1/2 cup chopped celery",
    "1/2 cup chopped green pepper (optional)",
    "1/2 cup chopped tomato",
    "1/2 cup chopped mint",
    "1/2 cup chopped leeks",
    "1/2 cup chopped bulghur wheat",
    "1/2 tsp. salt",
    "1/2 tsp. pepper"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "في قدر كبير، أضف الخروف والماء. اغلي وأزل أي رغوة."
    },
    {
      "@type": "HowToStep",
      "text": "خفّف النار واطهي على نار هادئة لمدة ساعة حتى ينضج الخروف."
    },
    {
      "@type": "HowToStep",
      "text": "أخرج الخروف، قطّع اللحم، وأعده إلى القدر."
    },
    {
      "@type": "HowToStep",
      "text": "أضف البرغل والشعير والجزر واللفت والكراث."
    },
    {
      "@type": "HowToStep",
      "text": "اطهي على نار هادئة لمدة 45 دقيقة حتى تنضج الحبوب والخضروات."
    },
    {
      "@type": "HowToStep",
      "text": "تبّل بالملح والفلفل."
    },
    {
      "@type": "HowToStep",
      "text": "قدّم ساخنًا مزيّنًا بالبقدونس الطازج."
    },
    {
      "@type": "HowToStep",
      "text": "Boil lamb shank in chicken broth until tender. Remove meat and bones."
    },
    {
      "@type": "HowToStep",
      "text": "Cut meat into small pieces and return to broth."
    },
    {
      "@type": "HowToStep",
      "text": "Add all vegetables and herbs. Simmer for 15 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Add bulghur wheat. Simmer for 15 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Slowly stir in 8 cups of soup mixture, then add remaining soup."
    },
    {
      "@type": "HowToStep",
      "text": "Continue cooking until thickened, about 3 minutes."
    }
  ]
}