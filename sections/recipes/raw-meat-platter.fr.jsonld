{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Plateau de viande crue",
  "author": "Shehirian family",
  "description": "Un mélange traditionnel d'agneau cru et de boulghour servi en galettes.",
  "recipeCategory": "Entrée",
  "recipeCuisine": "Moyen-Orientale",
  "recipeYield": "5-6 portions",
  "prepTime": "PT20M",
  "cookTime": "PT0M",
  "totalTime": "PT20M",
  "recipeIngredient": [
    "1 tasse (environ 450 g) d'agneau maigre haché deux fois",
    "Poivron vert, haché fin",
    "Persil, haché fin",
    "Oignons verts, hachés fin",
    "1 tasse de boulghour (fin)",
    "1 petit oignon, haché fin",
    "Piment de Cayenne (optionnel)",
    "Sel et poivre au goût"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Utilisez uniquement de l'agneau (morceau de gigot recommandé) et servez le jour même de la préparation."
    },
    {
      "@type": "HowToStep",
      "text": "Salez la viande et mélangez."
    },
    {
      "@type": "HowToStep",
      "text": "Ajoutez le boulghour, les oignons et les légumes hachés et pétrissez avec un peu d'eau jusqu'à obtenir une pâte homogène."
    },
    {
      "@type": "HowToStep",
      "text": "Formez des galettes de 5 cm et servez immédiatement, garnies de légumes hachés."
    }
  ]
}