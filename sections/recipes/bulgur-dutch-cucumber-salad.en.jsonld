{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Bulgor Dutch Cucumber Salad",
  "author": "Shehirian family",
  "description": "A creamy and refreshing salad with Bulgor, cucumbers, radishes, and a tangy sour cream dressing.",
  "recipeCategory": "Salad",
  "recipeCuisine": "Dutch",
  "recipeYield": "6 to 8 servings",
  "prepTime": "",
  "cookTime": "",
  "totalTime": "",
  "recipeIngredient": [
    "2 cups chilled cooked Bulgor wheat",
    "1-1/2 cups diced cucumbers",
    "1/4 cup sliced green onions",
    "2/3 cup thinly sliced radishes",
    "1 cup sour cream",
    "1 tablespoon tarragon vinegar, or lemon juice",
    "1 teaspoon salt",
    "1/8 teaspoon white pepper",
    "1 teaspoon sugar"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Combine in a salad bowl: chilled cooked Bulgor wheat, cucumbers, green onions, radishes, sour cream, tarragon vinegar (or lemon juice), salt, white pepper, and sugar."
    },
    {
      "@type": "HowToStep",
      "text": "Toss, and top with a dash of paprika."
    }
  ]
}