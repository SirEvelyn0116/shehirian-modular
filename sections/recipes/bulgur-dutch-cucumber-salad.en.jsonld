{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Bulgor Dutch Cucumber Salad",
  "author": "Shehirian family",
  "description": "A creamy and refreshing salad with Bulgor, cucumbers, radishes, and a tangy sour cream dressing.",
  "recipeCategory": "Salad",
  "recipeCuisine": "Dutch",
  "recipeYield": "6-8 servings",
  "prepTime": "PT15M",
  "cookTime": "PT15M",
  "totalTime": "PT30M",
  "recipeIngredient": [
    "1 cup cooked bulgur, cooled",
    "2 cups sliced cucumber",
    "1/2 cup sliced radishes",
    "1/2 cup sour cream",
    "2 tbsp mayonnaise",
    "1 tbsp white vinegar",
    "Salt and pepper to taste",
    "Fresh dill or chives for garnish"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Prepare bulgur and cool."
    },
    {
      "@type": "HowToStep",
      "text": "Combine bulgur, cucumber slices and radishes in a bowl."
    },
    {
      "@type": "HowToStep",
      "text": "Whisk together sour cream, mayonnaise, vinegar, salt and pepper; fold into salad."
    },
    {
      "@type": "HowToStep",
      "text": "Garnish with dill or chives and chill before serving."
    }
  ]
}