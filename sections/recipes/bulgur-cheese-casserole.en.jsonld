{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Bulgor Cheese Casserole",
  "author": "Shehirian family",
  "description": "A simple baked casserole mixing cooked Bulgor with cheese and tomatoes.",
  "recipeCategory": "Casserole",
  "recipeCuisine": "International",
  "recipeYield": "4 to 6 servings",
  "prepTime": "",
  "cookTime": "PT30M",
  "totalTime": "PT40M",
  "recipeIngredient": [
    "3 cups cooked Bulgor",
    "1 15-oz can tomatoes",
    "1/3 cup sliced cooked or canned mushrooms",
    "1/2 lb pasteurized process cheese, sliced",
    "2 tbsp chopped green pepper",
    "2 tbsp chopped onion",
    "Salt and pepper to taste"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Blend cooked Bulgor, mushrooms, green peppers, onion, salt and pepper."
    },
    {
      "@type": "HowToStep",
      "text": "Place half of the mixture in a shallow casserole, cover with half the cheese slices."
    },
    {
      "@type": "HowToStep",
      "text": "Then the rest of the Bulgor mixture. Cut the remaining cheese slices diagonally in half; arrange on the Bulgor mixture. Bake in a preheated moderate oven, 350°F., for 30 minutes."
    }
  ]
}