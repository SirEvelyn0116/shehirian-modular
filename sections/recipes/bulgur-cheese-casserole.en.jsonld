{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Bulgur Cheese Casserole",
  "author": "Shehirian family",
  "description": "A simple baked casserole mixing cooked bulgur with cheese and tomatoes.",
  "recipeCategory": "Casserole",
  "recipeCuisine": "International",
  "recipeYield": "4-6 servings",
  "prepTime": "PT10M",
  "cookTime": "PT30M",
  "totalTime": "PT40M",
  "recipeIngredient": [
    "3 cups cooked bulgur",
    "1 15-oz can tomatoes",
    "1/3 cup sliced mushrooms",
    "1/2 lb pasteurized process cheese, sliced",
    "2 tbsp chopped green pepper",
    "2 tbsp chopped onion",
    "Salt and pepper to taste"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Blend cooked bulgur, mushrooms, green peppers, onion, salt and pepper."
    },
    {
      "@type": "HowToStep",
      "text": "Place half of the mixture in a shallow casserole, cover with half the cheese slices."
    },
    {
      "@type": "HowToStep",
      "text": "Add the rest of the bulgur mixture, arrange remaining cheese and bake at 350°F (175°C) for 30 minutes."
    }
  ]
}