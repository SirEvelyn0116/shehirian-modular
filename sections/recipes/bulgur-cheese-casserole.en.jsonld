{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Bulgur Cheese Casserole",
  "description": "A simple baked casserole mixing cooked bulgur with cheese and tomatoes.",
  "author": { "@type": "Person", "name": "Laurence Evelyn" },
  "recipeCuisine": "International",
  "recipeCategory": "Casserole",
  "recipeYield": "4-6 servings",
  "prepTime": "PT10M",
  "cookTime": "PT30M",
  "totalTime": "PT40M",
  "recipeIngredient": [
    "3 cups cooked bulgur",
    "1 can (15 oz) tomatoes",
    "1/3 cup sliced mushrooms",
    "1/2 lb processed cheese, sliced",
    "2 tbsp chopped green pepper",
    "2 tbsp chopped onion",
    "Salt and pepper to taste"
  ],
  "recipeInstructions": [
    "Blend cooked bulgur, mushrooms, green pepper, onion, salt and pepper.",
    "Place half the bulgur mixture in a casserole and cover with half the cheese slices.",
    "Add remaining bulgur mixture and top with remaining cheese.",
    "Bake at 350°F (175°C) for 30 minutes."
  ],
  "keywords": "casserole,cheese,bulgur"
}
