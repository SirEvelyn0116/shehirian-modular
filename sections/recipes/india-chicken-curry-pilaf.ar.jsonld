  "name": "بيلاف دجاج بالكاري",
  "author": "Shehirian family",
  "description": "بيلاف دجاج كريمي بالكاري مع البرغل والتفاح.",
  "recipeCategory": "طبق رئيسي",
  "recipeCuisine": "من الطراز الهندي",
  "recipeYield": "5-6 حصص",
  "prepTime": "PT15M",
  "cookTime": "PT25M",
  "totalTime": "PT40M",
  "recipeIngredient": [
    "زبدة أو دهن دجاج، بصل مفروم، تفاح حامض، كرفس، مسحوق كاري، زنجبيل، دقيق، ملح، فلفل، مرق دجاج، كريمة أو حليب، دجاج مطبوخ مقطع، برغل"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "اقلِّ البصل والتفاح والكرفس في الزبدة؛ أضف التوابل والدقيق ثم حرك المرق والكريمة حتى تتكاثف."
    },
    {
      "@type": "HowToStep",
      "text": "أضف الدجاج المطبوخ والبرغل، غطّ واتركه يغلي ببطء 25 دقيقة."
    }
  ]
}