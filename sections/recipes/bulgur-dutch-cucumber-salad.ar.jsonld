{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "سلطة الخيار الهولندية بالبرغل",
  "author": "عائلة شيهريان",
  "description": "سلطة كريمية ومنعشة مع البرغل والخيار والفجل وصلصة حامضة بالقشطة الحامضة.",
  "recipeCategory": "سلطة",
  "recipeCuisine": "هولندية",
  "recipeYield": "6-8 حصص",
  "prepTime": "PT15M",
  "cookTime": "PT15M",
  "totalTime": "PT30M",
  "recipeIngredient": [
    "1 كوب برغل مطبوخ ومبرد",
    "2 كوب خيار مقطع شرائح",
    "1/2 كوب فجل مقطع شرائح",
    "1/2 كوب قشطة حامضة",
    "2 ملعقة طعام مايونيز",
    "1 ملعقة طعام خل أبيض",
    "ملح وفلفل حسب الذوق",
    "شبت طازج أو ثوم معمر للتزيين"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "حضّر البرغل واتركه يبرد."
    },
    {
      "@type": "HowToStep",
      "text": "اخلط البرغل وشرائح الخيار والفجل في وعاء."
    },
    {
      "@type": "HowToStep",
      "text": "اخلط القشطة الحامضة والمايونيز والخل والملح والفلفل ثم اخلطها مع السلطة."
    },
    {
      "@type": "HowToStep",
      "text": "زَين بالشبت أو الثوم المعمر وضعها في الثلاجة قبل التقديم."
    }
  ]
}