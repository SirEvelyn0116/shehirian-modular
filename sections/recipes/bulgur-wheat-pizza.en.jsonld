{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Bulgor Wheat Pizza",
  "author": "Shehirian family",
  "description": "A pizza variation using Bulgor in the dough and a hearty meat-and-vegetable sauce.",
  "recipeCategory": "Main Dish",
  "recipeCuisine": "International",
  "recipeYield": "2 pizzas (12-in.)",
  "prepTime": "PT1H15M",
  "cookTime": "PT40M",
  "totalTime": "PT1H55M",
  "recipeIngredient": [
    "Pizza Sauce: oil, green bell pepper, onion, mushrooms, garlic, Italian sausage, lean ground beef, tomato purée, tomato sauce, water, Parmesan, bay leaf, pepper, salt, oregano",
    "Pizza Dough: 1/2 cup bulgur, 1-3/4 cups water, active dry yeast, flour, salt, oil",
    "Assembly: slices of mozzarella, grated Parmesan"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Prepare the sauce: sauté vegetables and meats, add tomato purée, sauce, water, cheese and seasonings; simmer 90 minutes total."
    },
    {
      "@type": "HowToStep",
      "text": "Prepare the dough: cook bulgur in water until absorbed, cool; dissolve yeast and mix with flour, bulgur, oil; let rise, divide, roll to 12-inch rounds."
    },
    {
      "@type": "HowToStep",
      "text": "Assemble with mozzarella and sauce and bake at 375°F (190°C) for 35–40 minutes."
    }
  ]
}