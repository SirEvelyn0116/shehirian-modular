{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Bulgor Wheat Pizza",
  "author": "Shehirian family",
  "description": "A pizza variation using Bulgor in the dough and a hearty meat-and-vegetable sauce.",
  "recipeCategory": "Main Dish",
  "recipeCuisine": "International",
  "recipeYield": "2 pizzas (12-in. in diameter)",
  "prepTime": "",
  "cookTime": "",
  "totalTime": "",
  "recipeIngredient": [
    "Pizza Sauce:",
    "2 tablespoons oil",
    "1/4 cup chopped onion",
    "1/4 cup chopped green bell pepper",
    "1/4 cup sliced mushrooms (drained, if canned)",
    "1/4 teaspoon minced garlic",
    "1/4 pound Italian sausage, thinly sliced",
    "3/4 pound lean ground beef",
    "1 can (6-oz.) tomato purée",
    "3 cups tomato sauce",
    "3 cups water",
    "2 tablespoons grated Parmesan cheese",
    "Snip of bay leaf",
    "1/4 teaspoon pepper",
    "1 teaspoon salt",
    "3/4 teaspoon oregano",
    "Pizza Dough:",
    "1/2 cup Bulgor",
    "1-3/4 cups water",
    "1 package (1/4 oz.) active dry yeast",
    "1/4 cup lukewarm water",
    "2-1/2 cups flour",
    "1 teaspoon salt",
    "1 tablespoon oil",
    "Finished Pizza:",
    "Slices of mozzarella cheese",
    "Grated Parmesan cheese"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Heat the oil; add the onion, green bell pepper, mushrooms, garlic, Italian sausage, and ground beef."
    },
    {
      "@type": "HowToStep",
      "text": "Sauté over moderate heat until onions are straw-coloured."
    },
    {
      "@type": "HowToStep",
      "text": "Add the tomato purée, tomato sauce, water, Parmesan, bay leaf, pepper, salt, and oregano."
    },
    {
      "@type": "HowToStep",
      "text": "Cover and simmer slowly 45 minutes; uncover and continue to simmer slowly 45 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Combine the Bulgor and water; cover and bring to a simmer. Simmer 15 minutes or until most of the liquid is absorbed; cool to lukewarm."
    },
    {
      "@type": "HowToStep",
      "text": "Dissolve the yeast in the lukewarm water. Sift together the flour and salt, and add the oil."
    },
    {
      "@type": "HowToStep",
      "text": "Stir in the cooked Bulgor and the yeast mixture; mix thoroughly, until the dough leaves the sides of the bowl. Lightly oil the surface of the dough, cover, and let rise in a warm place, about 85°F, until doubled in volume, about 1-1/2 hours."
    },
    {
      "@type": "HowToStep",
      "text": "Divide the dough in half; roll each half into a circle to fit a 12-inch pizza pan. Brush the surface lightly with oil, and let rise in a warm place about 20 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Arrange slices of mozzarella cheese on the surface of the pizza crust, top with a layer of sauce, and sprinkle with grated Parmesan cheese."
    },
    {
      "@type": "HowToStep",
      "text": "Bake in a moderately hot oven, 375°F, 35 to 40 minutes."
    }
  ]
}