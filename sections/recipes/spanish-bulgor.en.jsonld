{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Spanish Bulgor",
  "author": "Shehirian family",
  "description": "A hearty skillet bulgur with bacon, peppers, tomatoes and seasonings.",
  "recipeCategory": "Side Dish",
  "recipeCuisine": "Spanish-inspired",
  "recipeYield": "5 to 6 servings",
  "prepTime": "PT10M",
  "cookTime": "PT25M",
  "totalTime": "PT35M",
  "recipeIngredient": [
    "4 slices bacon cut in 1/2-inch strips",
    "1/2 to 3/4 cup chopped onion",
    "1/2 cup chopped celery",
    "1/2 cup chopped green bell pepper",
    "1 clove garlic, finely minced",
    "1 can (10 oz.) tomatoes",
    "2 cups water",
    "1/2 teaspoon salt",
    "1 teaspoon seasoned salt",
    "1/4 teaspoon pepper",
    "1 teaspoon sugar",
    "1 teaspoon Worcestershire Sauce",
    "1 cup Bulgor Wheat"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Sauté bacon strips in a heavy skillet until they begin to brown."
    },
    {
      "@type": "HowToStep",
      "text": "Add onion, celery, green bell pepper, and garlic and cook until onion is straw-coloured."
    },
    {
      "@type": "HowToStep",
      "text": "Blend in the tomatoes, water, seasonings, and Bulgor Wheat."
    },
    {
      "@type": "HowToStep",
      "text": "Cover and simmer over low heat until most of liquid is absorbed, 20 to 25 minutes."
    }
  ]
}