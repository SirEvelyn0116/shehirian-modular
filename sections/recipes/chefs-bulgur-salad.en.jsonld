{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Chef's Bulgor Salad",
  "author": "Shehirian family",
  "description": "A Bulgor salad with french dressing, sweet pickle, celery, and green pepper, topped with cold meat and cheese.",
  "recipeCategory": "Main Course",
  "recipeCuisine": "American",
  "recipeYield": "6 servings",
  "prepTime": "",
  "cookTime": "",
  "totalTime": "",
  "recipeIngredient": [
    "2-1/2 cups cooked Bulgor",
    "1/3 cup French dressing",
    "3 tablespoons chopped sweet pickle",
    "1/2 teaspoon salt",
    "1/8 teaspoon pepper",
    "1/3 cup chopped green bell pepper",
    "1 cup thinly sliced celery",
    "1 to 2 teaspoons minced onion"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Blend Bulgor wheat, French dressing, pickle, salt and pepper; chill."
    },
    {
      "@type": "HowToStep",
      "text": "Add green pepper, sliced celery and onion."
    },
    {
      "@type": "HowToStep",
      "text": "Mix well; serve on a bed of salad greens which have been tossed with French dressing."
    },
    {
      "@type": "HowToStep",
      "text": "Top with thin strips of cold boiled ham or tongue, cold chicken or turkey, and Canadian or Swiss cheese."
    }
  ]
}