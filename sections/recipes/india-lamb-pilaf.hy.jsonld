{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "India գառի միս Pilaf",
  "author": "Շահիրյան ընտանիք",
  "description": "A spiced գառի միս pilaf with curry and apples, using ձավարի ցորեն.",
  "recipeCategory": "Հիմնական ուտեստ",
  "recipeCuisine": "Indian-Inspired",
  "recipeYield": "5-6 պորցիա",
  "prepTime": "PT15M",
  "cookTime": "PT40M",
  "totalTime": "PT55M",
  "recipeIngredient": [
    "Ձեթ, եփած գառան միս cubes, մանրացված սոխ, tart apple, սխտոր, նեխուր seed, կարի powder, կծու, աղ, պղպեղ, tabasco, լոլիկ purée, consommé or ջուր, 1 բաժակ ձավար"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Տապակել գառան միս with սոխ, apple and սխտոր; շագանակագույն դարձնել lightly."
    },
    {
      "@type": "HowToStep",
      "text": "Blend in remaining ingկարմիրients, bring to եփել then եփել դանդաղ կրակով about 40 րոպե until thickened."
    }
  ]
}