{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Bulgor Apricot Delight with Eggnog Sauce",
  "description": "A chilled apricot-flavored bulgur dessert topped with a rich eggnog-style sauce.",
  "recipeYield": "6 servings",
  "prepTime": "PT10M",
  "cookTime": "PT15M",
  "totalTime": "PT25M",
  "recipeIngredient": [
    "1 cup apricot nectar (or juice)",
    "1-1/2 cups water",
    "1/4 teaspoon salt",
    "1 cup Bulgor wheat",
    "3 tablespoons sugar (for Bulgor)",
    "1 tablespoon lemon juice",
    "Apricot halves (for garnish)",
    "Eggnog Sauce: 1 egg, 1/2 cup sugar, 1 teaspoon vanilla, 2 tablespoons sherry or rum (optional), 1/2 cup heavy cream, whipped"
  ],
  "recipeInstructions": [
    { "@type": "HowToStep", "text": "Mix apricot nectar, water, salt, and Bulgor; cover and simmer until juice is absorbed, stirring occasionally." },
    { "@type": "HowToStep", "text": "Stir in sugar, cover and cook 5 more minutes; chill and stir in lemon juice." },
    { "@type": "HowToStep", "text": "Prepare eggnog sauce by beating egg, gradually adding sugar and vanilla, add sherry if using, then fold in whipped cream; top each serving with sauce and an apricot half." }
  ]
}
