{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Scalloped Bulgur with Wieners",
  "description": "A creamy baked bulgur casserole topped with wieners.",
  "author": { "@type": "Person", "name": "Laurence Evelyn" },
  "recipeCategory": "Casserole",
  "recipeYield": "5-6 servings",
  "prepTime": "PT10M",
  "cookTime": "PT50M",
  "totalTime": "PT1H",
  "recipeIngredient": [
    "2-1/2 cups cooked bulgur",
    "1 egg",
    "2 tbsp chopped onion",
    "1 can condensed cream of mushroom soup",
    "1/2 tsp salt",
    "3/4 cup milk",
    "5-6 wieners"
  ],
  "recipeInstructions": [
    "Blend bulgur, egg, onion, condensed soup, salt and milk in a shallow baking dish.",
    "Bake at 350°F (175°C) until partially set (~30 minutes).",
    "Top with wieners, brush with melted margarine and continue baking 15–20 minutes until lightly browned."
  ],
  "keywords": "scalloped,bulgur,wieners"
}
