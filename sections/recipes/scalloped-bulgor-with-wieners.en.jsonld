{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Scalloped Bulgur with Wieners",
  "author": "Shehirian family",
  "description": "A creamy baked bulgur dish topped with wieners.",
  "recipeCategory": "Casserole",
  "recipeCuisine": "Comfort Food",
  "recipeYield": "5-6 servings",
  "prepTime": "PT10M",
  "cookTime": "PT50M",
  "totalTime": "PT1H",
  "recipeIngredient": [
    "2-1/2 cups cooked bulgur",
    "1 egg slightly beaten",
    "2 tbsp chopped onion",
    "1 can condensed cream of mushroom soup",
    "1/2 tsp salt",
    "3/4 cup milk",
    "5-6 wieners"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Blend bulgur, egg, onion, condensed soup, salt and milk in shallow baking dish."
    },
    {
      "@type": "HowToStep",
      "text": "Bake at 350°F (175°C) until partially set (~30 minutes)."
    },
    {
      "@type": "HowToStep",
      "text": "Top with wieners, brush with margarine and continue baking 15–20 minutes until browned."
    }
  ]
}