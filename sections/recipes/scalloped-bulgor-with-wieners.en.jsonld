{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Scalloped Bulgor with Wieners",
  "author": "Shehirian family",
  "description": "A creamy baked Bulgor dish topped with wieners.",
  "recipeCategory": "Casserole",
  "recipeCuisine": "Comfort Food",
  "recipeYield": "5 to 6 servings",
  "prepTime": "",
  "cookTime": "",
  "totalTime": "",
  "recipeIngredient": [
    "2-1/2 cups cooked bulgur",
    "1 egg, slightly beaten",
    "2 tbsp chopped onion",
    "1 can (10-1/2 oz.) condensed cream of mushroom soup",
    "1/2 tsp salt",
    "3/4 cup milk",
    "5 to 6 wieners"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Blend Bulgor, egg, onion, condensed soup, salt and milk in shallow baking dish."
    },
    {
      "@type": "HowToStep",
      "text": "Bake at 350°F until partially set (about 30 minutes)."
    },
    {
      "@type": "HowToStep",
      "text": "Top with wieners; brush with melted margarine or oil. Continue baking until wieners are lightly browned, 15 to 20 minutes."
    }
  ]
}