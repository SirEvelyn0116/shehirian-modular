{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "البرغل المقلي على الطريقة الصينية",
  "description": "برغل مقلي سريع مع صلصة الصويا والخضار، يُقدّم كطبق جانبي أو رئيسي.",
  "author": { "@type": "Person", "name": "لورنس إيفلين" },
  "recipeCuisine": "من الطراز الصيني",
  "recipeCategory": "طبق رئيسي/جانبي",
  "recipeYield": "4-5 حصص",
  "prepTime": "PT5M",
  "cookTime": "PT15M",
  "totalTime": "PT20M",
  "recipeIngredient": [
    "2 ملعقة طعام زيت",
    "3/4 كوب بصل مفروم ناعماً",
    "1/2 كوب فلفل أخضر مفروم ناعماً",
    "1/2 كوب كرفس مفروم ناعماً",
    "2.5 كوب برغل مطبوخ",
    "2 ملعقة طعام صويا"
  ],
  "recipeInstructions": [
    "سخّن الزيت في مقلاة وقلّب البصل والفلفل والكرفس حتى يذبلا.",
    "أضف البرغل المطبوخ والصويا؛ غط واتركه على نار هادئة 15 دقيقة مع التحريك من حين لآخر."
  ],
  "keywords": "برغل مقلي,صويا,خضار"
}
