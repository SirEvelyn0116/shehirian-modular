{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "البرغل المقلي على الطريقة الصينية",
  "author": "عائلة شيهريان",
  "description": "برغل مقلي سريع مع صلصة الصويا والخضار، يُقدّم كطبق جانبي أو رئيسي.",
  "recipeCategory": "طبق رئيسي/جانبي",
  "recipeCuisine": "من الطراز الصيني",
  "recipeYield": "4-5 حصص",
  "prepTime": "PT5M",
  "cookTime": "PT15M",
  "totalTime": "PT20M",
  "recipeIngredient": [
    "2 ملعقة طعام زيت",
    "3/4 كوب بصل مفروم ناعماً",
    "1/2 كوب فلفل أخضر مفروم ناعماً",
    "1/2 كوب كرفس مفروم ناعماً",
    "2.5 كوب برغل مطبوخ",
    "2 ملعقة طعام صويا"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "سخّن الزيت في مقلاة، قلّب البصل والفلفل والكرفس حتى يذبلا."
    },
    {
      "@type": "HowToStep",
      "text": "أضف البرغل المطبوخ والصويا؛ غطِ واتركه على نار هادئة 15 دقيقة مع التحريك من وقت لآخر."
    }
  ]
}